---
import { Icon } from "astro-icon/components";
import Reveal from "@components/reveal.astro";
import { getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;

/*
  Copy discipline for this file. See AGENTS.md for the full voice specification.

  The page argues one thing: audit before you automate. The enemy is premature
  automation - building against a bottleneck nobody confirmed. The offer is the
  360 read across sales, marketing, product, analytics and ML, and the outcome
  the work aims at is more qualified meetings, never more automation.

  "More qualified meetings" is stated as the goal of the work, never as a
  guaranteed result. There are no client engagements yet and the voice spec
  forbids guarantees.

  - Nine sections, hard ceiling. Anything new displaces something.
  - Exactly one rendered process diagram: the method chain in section 4.
  - The thesis line ("Outbound rarely fails at sending...") appears once, section 3.
  - HOLD is stated as one philosophy operating at two levels, in section 6.
  - First person singular. Founder-led agency, no team.
  - Present tense only for what runs today; hedge in the same sentence for what is
    in testing; future framing for what is planned.
*/

const symptoms = [
  "Leads arrive. Demos do not happen at anything like the same rate, and nobody agrees why.",
  "Your head of sales says it's lead quality. Marketing says it's follow-up. Both have data.",
  "You bought the tool. Activity went up. Bookings did not.",
  "You've fixed the thing everyone agreed was broken. Twice. The number didn't move.",
  "Every specialist you hire describes the problem in the shape of their own job.",
  "The CRM says forty opportunities. You know six of them are real.",
];

const whyNobodyTells = [
  {
    title: "Tools assume the diagnosis is already done",
    text: "Every AI GTM tool starts after the decision. They make sending cheaper, faster and higher-volume. Sending was never the constraint - you could already send more email than anyone wanted to receive.",
  },
  {
    title: "Agencies sell execution in one lane",
    text: "Hire an outbound agency and you get outbound, whether or not outbound was the problem. The engagement is defined before anyone has looked at where the motion actually breaks.",
  },
  {
    title: "Both are built by single-domain people",
    text: "Building an outbound tool is a few weeks of engineering now. Knowing whether outbound is even your bottleneck is not, and it does not come out of a model.",
  },
  {
    title: "So the diagnosis is nobody's job",
    text: "Brands are not built by funding or by shipping more. Distribution is sales and marketing working as one motion - and almost nobody in this category has run both.",
  },
];

const domains = ["Sales", "Marketing", "Product management", "Analytics", "Machine learning"];

const pipeline = [
  {
    n: "01",
    label: "Research",
    icon: "heroicons:magnifying-glass",
    text: "Live web research on one account, returned as a structured read: what the company actually did, said, built or hired for, with the source behind each observation.",
  },
  {
    n: "02",
    label: "Reason",
    icon: "heroicons:light-bulb",
    text: "The strongest signal becomes a commercial interpretation and one testable hypothesis, matched against real experience. If nothing credible connects, it stops here.",
  },
  {
    n: "03",
    label: "Judge",
    icon: "heroicons:scale",
    text: "The draft is checked against a fixed set of quality checks covering whether claims trace to evidence, whether inference is marked as inference, and whether anything about the company was invented.",
  },
  {
    n: "04",
    label: "You decide",
    icon: "heroicons:hand-raised",
    text: "Output is a file you read. Nothing is connected to your inbox and nothing is sent. Sending is optional, manual and yours.",
  },
];

const refusals = [
  {
    title: "It will not manufacture confidence",
    text: "If the evidence does not support a commercial argument, it stops and says why. It does not produce a message because a message was expected.",
  },
  {
    title: "It will not present a guess as a fact",
    text: "Anything resting on inference is written as curiosity, not diagnosis. The output keeps the two apart on purpose.",
  },
  {
    title: "It does not know who will buy",
    text: "It assesses whether there is a defensible reason to start a conversation. That is a smaller and more honest question than intent scoring.",
  },
  {
    title: "It does not replace your judgement",
    text: "It removes the research and first-draft work. The decision to contact someone stays with the person whose name is on the message.",
  },
];

// The one rendered process diagram on this page.
const method = [
  { label: "Audit", icon: "heroicons:magnifying-glass", text: "Map the motion, the data and the stack as they actually run today." },
  { label: "Diagnose", icon: "heroicons:light-bulb", text: "Name where lead-to-demo is leaking, and rule out the explanations that do not hold." },
  { label: "Readiness", icon: "heroicons:scale", text: "Establish what your stack and data can actually support. Sometimes the answer is not yet." },
  { label: "Build", icon: "heroicons:wrench-screwdriver", text: "Build only what the audit supports, on the infrastructure you already run." },
  { label: "Deploy", icon: "heroicons:rocket-launch", text: "Run it on real accounts, against a baseline captured before anything changed." },
  { label: "Measure", icon: "heroicons:chart-bar", text: "Qualified bookings. Not activity, not replies, not seats." },
];

/*
  The stack grouped by GTM layer. The layer structure is the argument; the tool
  names are the evidence. This is the landscape I work across - not a claim that
  every one is a pre-built connector.
*/
const stackLayers = [
  { layer: "Data & enrichment", icon: "heroicons:circle-stack", tools: "Clay, ZoomInfo, Apollo, Clearbit, LinkedIn Sales Navigator, Ocean.io, Exa" },
  { layer: "Signals & intent", icon: "heroicons:signal", tools: "Common Room, Warmly, RB2B, Clay signals, G2 buyer intent, job-change and funding triggers" },
  { layer: "Sales engagement & outbound", icon: "heroicons:paper-airplane", tools: "Outreach, Salesloft, Smartlead, Instantly, Lemlist, HeyReach, La Growth Machine, Apollo sequences" },
  { layer: "CRM & system of record", icon: "heroicons:rectangle-stack", tools: "HubSpot, Salesforce, Attio, Pipedrive, Close" },
  { layer: "Revenue intelligence", icon: "heroicons:chat-bubble-left-right", tools: "Gong, Clari, Chorus, Avoma" },
  { layer: "Data, orchestration & reporting", icon: "heroicons:cpu-chip", tools: "n8n, LangGraph, PostgreSQL, Snowflake, BigQuery, dbt, Hightouch, Census, Metabase, Looker, Segment" },
  { layer: "Scheduling & routing", icon: "heroicons:calendar-days", tools: "Chili Piper, Calendly, Default" },
];

const ladder = [
  {
    n: "01",
    name: "Intro call",
    price: "Free",
    note: "30 minutes",
    text: "Short, and its only job is to work out whether any of this applies to you. Some conversations end here, which is a fine outcome.",
    limit: "No deck, no pitch. If the problem is not one I can help with, I will say so on the call.",
  },
  {
    n: "02",
    name: "GTM Audit",
    price: "$200 - $500",
    note: "2-3 days · written · needs data access",
    text: "A paid, written read of how your go-to-market actually runs. It names where the motion breaks, which of the competing explanations holds up, what is genuinely worth handing to a system, and what a sensible first pilot would cover.",
    limit: "Where you land in that range depends on how tangled the stack is, how clean the pipeline data is, and whether there is someone technical on your side to work with. It is an audit, not an implementation, and it makes no revenue promises.",
  },
  {
    n: "03",
    name: "Pilot",
    price: "$1,200 - $3,000",
    note: "scoped to one named constraint",
    text: "One motion, one cohort, one question worth answering. Research and evidence gathering run on the Amoris engine. Review, sending and response handling stay deliberate and human, on your infrastructure and your domain.",
    limit: "The deliverable is evidence. What counts as a result is agreed before it starts, and the baseline is captured first, because it can only be measured once.",
  },
  {
    n: "04",
    name: "Ongoing systems work",
    price: "Scoped",
    note: "retained, after the pilot",
    text: "What the pilot proved, extended across more of the motion, with me working alongside your team rather than in place of it.",
    limit: "Priced once there is evidence about what actually moved. Quoting it earlier is guessing, and you would be paying for the guess.",
  },
];

const introCall = "https://calendly.com/praveenshahi13/30min";

const productsUrl = getLocaleUrl('products', locale);
const pricingUrl = getLocaleUrl('pricing', locale);
const founderUrl = getLocaleUrl('founder', locale);
const architectureUrl = getLocaleUrl('architecture', locale);
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- ════ 2. Recognition ════ -->
  <div class="container mx-auto py-24 sm:py-28">
    <section aria-labelledby="home-symptoms-heading">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-20">
        <!-- The claim holds still while the evidence scrolls past it. -->
        <Reveal tier="statement" from="left" class="lg:sticky lg:top-32 lg:self-start">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Some of this will sound familiar</span>
          <h2 id="home-symptoms-heading" class="mt-4 text-3xl font-bold text-balance sm:text-4xl">
            The most expensive thing in GTM is solving the wrong problem well.
          </h2>
          <p class="mt-5 leading-relaxed text-stone-600 dark:text-stone-300">
            None of these are automation problems. Every one of them is a symptom of a decision nobody has actually made yet.
          </p>
          <div class="from-primary/60 mt-8 h-px w-24 bg-linear-to-r to-transparent"></div>
        </Reveal>

        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {
            symptoms.map((sym, i) => (
              <Reveal as="li" delay={i * 70} tier="tight" from="up" class="symptom group m-0">
                <div class="relative overflow-hidden rounded-xl border border-stone-200 bg-white p-6 pl-16 dark:border-stone-800 dark:bg-stone-900/60">
                  {/* Accent rail: fills from the top on hover. */}
                  <span class="bg-primary/70 dark:bg-primary-light/70 absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 transition-transform duration-400 ease-out group-hover:scale-y-100" aria-hidden="true" />
                  {/* Ghost numeral, sitting behind the text rather than beside it. */}
                  <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 font-mono text-3xl font-bold text-stone-200 tabular-nums transition-colors duration-300 select-none group-hover:text-stone-300 dark:text-stone-700 dark:group-hover:text-stone-600" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <p class="m-0 text-lg leading-relaxed text-stone-700 dark:text-stone-200">{sym}</p>
                </div>
              </Reveal>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- ════ 3. Premature automation ════ -->
  <div class="a-band-dark">
    <div class="container mx-auto py-28 sm:py-32">
      <section aria-labelledby="home-cause-heading">
        <Reveal tier="statement" class="mx-auto mb-14 flex max-w-3xl flex-col items-center gap-5 text-center">
          <span class="text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The real enemy</span>
          <h2 id="home-cause-heading" class="text-4xl font-bold text-balance sm:text-5xl">Most GTM automation fixes a bottleneck nobody confirmed.</h2>
          <p class="text-xl leading-relaxed text-stone-300">
            The category is incentivised to tell you that you have an SDR problem, because it sells AI SDRs. Maybe you do. The point is that nobody checked - and automating the wrong step does not just fail, it buries the real problem under six weeks of new infrastructure.
          </p>
          <p class="leading-relaxed text-stone-400">
            Outbound rarely fails at sending. It fails at deciding what to say - which account, what to say to them, whether it is worth saying at all. That step takes judgement and context from more than one part of the business, it does not scale with headcount or tooling, and it is invisible in every activity metric you have. So it is the first thing dropped, and its absence surfaces somewhere else entirely: as a lead quality argument, a follow-up argument, a positioning argument.
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            whyNobodyTells.map((item, i) => (
              <Reveal delay={i * 70} tier="tight" from="up">
                <div class="a-band-card flex h-full flex-col gap-2 rounded-xl border border-white/12 bg-white/[0.045] p-6 backdrop-blur-sm">
                  <h3 class="text-base font-bold text-white">{item.title}</h3>
                  <p class="text-sm leading-relaxed text-stone-300">{item.text}</p>
                </div>
              </Reveal>
            ))
          }
        </div>

        <Reveal class="mt-8">
          <p class="mx-auto max-w-2xl text-center text-xl font-semibold text-balance text-white">
            So the first question is not which tool. It is whether the thing you are about to automate is the thing that is actually costing you meetings.
          </p>
        </Reveal>
      </section>
    </div>
  </div>

  <!-- ════ 4. The sequence ════ -->
  <div class="container mx-auto py-24">
    <section id="how-it-works" aria-labelledby="home-method-heading" class="scroll-mt-28">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">How the work runs</span>
        <h2 id="home-method-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">Audit, then automate. In that order, every time.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Nothing gets built before the diagnosis, nothing widens before it has been measured, and the last step is a business number rather than an activity one.
        </p>
      </Reveal>

      <div>
        <ol class="method-chain m-0 grid list-none grid-cols-1 gap-0 p-0 sm:grid-cols-2 lg:grid-cols-6" aria-label="How an engagement runs">
          {
            method.map((step, i) => (
              <Reveal as="li" tier="tight" from="up" delay={i * 110} class="method-step relative m-0 flex flex-col gap-2 border border-stone-300 bg-white p-5 dark:border-stone-700 dark:bg-stone-900">
                <div class="flex items-center gap-2">
                  <Icon name={step.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                  <span class="font-mono text-xs text-stone-400 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <span class="text-base font-bold">{step.label}</span>
                <p class="m-0 text-xs leading-relaxed text-stone-600 dark:text-stone-300">{step.text}</p>
              </Reveal>
            ))
          }
        </ol>
      </div>

      <Reveal class="mt-8">
        <p class="mx-auto max-w-2xl text-center text-sm text-stone-500 dark:text-stone-400">
          Readiness is a real step, not a formality. Some stacks are not in a state where automation would hold, and finding that out for the price of an audit is cheaper than finding it out for the price of a build.
        </p>
      </Reveal>
    </section>
  </div>

  <!-- ════ 5. Who is behind this ════ -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-24 sm:py-28">
      <section aria-labelledby="home-founder-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Who's behind this</span>
          <h2 id="home-founder-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">The judgement being automated is mine, and you can check where it came from.</h2>
        </Reveal>

        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
          <Reveal from="left" class="mx-auto w-full max-w-sm lg:sticky lg:top-28 lg:mx-0">
            <img
              src="/founder.png"
              alt="Praveen Shahi, founder of Amoris"
              width="288"
              height="288"
              loading="lazy"
              decoding="async"
              class="border-primary/30 aspect-square w-full rounded-2xl border-2 object-cover"
            />
            <ul class="mt-5 flex list-none flex-col gap-1.5 p-0">
              {
                domains.map((d) => (
                  <li class="m-0 flex items-center gap-2 text-sm text-stone-600 dark:text-stone-300">
                    <Icon name="heroicons:check-circle" class="text-primary dark:text-primary-light h-4 w-4 shrink-0" aria-hidden="true" />
                    {d}
                  </li>
                ))
              }
            </ul>
          </Reveal>

          <Reveal from="right" class="flex flex-col gap-4">
            <p class="text-lg leading-relaxed text-stone-700 dark:text-stone-200">
              <strong>Praveen Shahi.</strong> Four years at Amazon and Meta on global data science and ML projects - finding patterns in systems large enough that intuition stops working and design has to take over. That is where I learned how a system is actually put together.
            </p>
            <p class="leading-relaxed text-stone-600 dark:text-stone-300">
              Then I went and carried a number. Seven years of sales and growth hacking since - building teams, opening new markets from scratch, and running growth for brands at very different stages. Enough range to recognise a problem I have seen before wearing different clothes.
            </p>

            <!-- Scale of prior operating work. Range, not results - see the caption. -->
            <ul class="m-0 grid list-none grid-cols-2 gap-px overflow-hidden rounded-xl border border-stone-300 bg-stone-300 p-0 sm:grid-cols-4 dark:border-stone-700 dark:bg-stone-700">
              {
                [
                  { figure: "7+", label: "years in sales and growth" },
                  { figure: "150", label: "largest sales team led" },
                  { figure: "6+", label: "brands grown" },
                  { figure: "Millions", label: "in sales closed" },
                ].map((s) => (
                  <li class="m-0 flex flex-col gap-0.5 bg-white p-4 dark:bg-stone-900">
                    <span class="text-primary dark:text-primary-light text-2xl font-bold">{s.figure}</span>
                    <span class="text-xs leading-snug text-stone-600 dark:text-stone-300">{s.label}</span>
                  </li>
                ))
              }
            </ul>
            <p class="m-0 text-sm text-stone-500 dark:text-stone-400">
              Operating work before Amoris, across LATAM, Africa and India - not Amoris client results, and not a forecast of what any engagement produces. The detail is on <a href="https://www.linkedin.com/in/praveenshahi13" target="_blank" rel="noopener">LinkedIn</a>.
            </p>
            <p class="leading-relaxed text-stone-600 dark:text-stone-300">
              Most people in this category have one half. The system designers have never had to explain a missed quarter. The revenue operators are waiting on an engineering team. The value is not either half on its own - it is that one person carries both, and can therefore tell you which half your problem actually lives in.
            </p>

            <div class="border-primary/30 mt-2 flex flex-col gap-2 rounded-xl border-2 bg-white p-6 dark:bg-stone-900">
              <h3 class="text-base font-bold">How this works, and what it is not</h3>
              <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                I think it through with you. I do not take the decision off your desk - you know things about your business that no diagnostic surfaces, and handing the call to an outsider is how companies end up executing someone else's guess very well.
              </p>
              <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                Founder-led means the senior judgement is on your engagement directly, not delegated to a junior team. There isn't one.
              </p>
            </div>

            <a href={founderUrl} class="btn-subtle group mt-2 w-fit rounded px-4 py-[0.43rem]">
              <span>The longer version, including what broke</span>
              <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
            </a>
          </Reveal>
        </div>
      </section>
    </div>
  </div>

  <!-- ════ 6. How the judgement scales ════ -->
  <div class="container mx-auto py-20">
    <section id="research-engine" aria-labelledby="home-engine-heading" class="scroll-mt-28">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">How the judgement scales</span>
        <h2 id="home-engine-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">The system is not the strategy. It is how good decisions stop being limited by one person's hours.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Give it one company. It researches the account live, works out whether there is a defensible reason to start a conversation, and hands you a read you can act on.
        </p>
      </Reveal>

      <ol class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2">
        {
          pipeline.map((step, i) => (
            <Reveal as="li" delay={i * 60} from="up" class="m-0">
              <article class="a-card a-card-hover flex h-full flex-col gap-3">
                <div class="flex items-center gap-3">
                  <span class="text-primary dark:text-primary-light font-mono text-2xl font-bold tabular-nums">{step.n}</span>
                  <span class="flex items-center gap-2 text-lg font-bold">
                    <Icon name={step.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                    {step.label}
                  </span>
                </div>
                <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{step.text}</p>
              </article>
            </Reveal>
          ))
        }
      </ol>

      <!-- The philosophy, stated once, operating at two levels -->
      <Reveal class="mb-10">
        <div class="a-card overflow-hidden p-0">
          <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="flex flex-col gap-2 border-b border-stone-300 p-6 sm:p-8 md:border-r md:border-b-0 dark:border-stone-700">
              <span class="flex items-center gap-2 font-mono text-xs font-semibold tracking-widest text-amber-600 uppercase dark:text-amber-400">
                <Icon name="heroicons:pause-circle" class="h-4 w-4 shrink-0" aria-hidden="true" />
                Before building
              </span>
              <p class="m-0 leading-relaxed text-stone-600 dark:text-stone-300">
                Do not automate until the audit supports it. If the evidence is not there, the honest answer is <strong>not yet</strong>.
              </p>
            </div>
            <div class="flex flex-col gap-2 p-6 sm:p-8">
              <span class="flex items-center gap-2 font-mono text-xs font-semibold tracking-widest text-green-700 uppercase dark:text-green-400">
                <Icon name="heroicons:hand-raised" class="h-4 w-4 shrink-0" aria-hidden="true" />
                Inside the system
              </span>
              <p class="m-0 leading-relaxed text-stone-600 dark:text-stone-300">
                Do not reach out until the account evidence supports it. If it is not there, the pipeline <strong>stops and says why</strong>.
              </p>
            </div>
          </div>
          <p class="m-0 border-t border-stone-300 bg-stone-100 px-6 py-4 text-sm text-stone-600 sm:px-8 dark:border-stone-700 dark:bg-stone-800 dark:text-stone-300">
            One philosophy, applied twice. HOLD is not a feature bolted onto the product - it is the same discipline the engagement itself runs on.
          </p>
        </div>
      </Reveal>

      <!-- HOLD -->
      <Reveal class="mt-8">
        <div class="border-primary/30 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 rounded-xl border-2 bg-linear-to-br via-white p-6 sm:p-8 dark:via-stone-900">
          <div class="flex flex-col gap-3">
            <h3 class="flex items-center gap-2 text-xl font-bold">
              <Icon name="heroicons:hand-raised" class="text-primary dark:text-primary-light h-6 w-6 shrink-0" aria-hidden="true" />
              HOLD is the point, not the exception
            </h3>
            <p class="leading-relaxed text-stone-600 dark:text-stone-300">
              The pipeline can stop at two places. It stops before writing anything if the evidence will not support a credible commercial argument. It stops after writing if a claim about the company cannot be traced back to the research. Either way it tells you which, and why.
            </p>
            <p class="leading-relaxed text-stone-600 dark:text-stone-300">
              A HOLD is not a failure state. It usually says something true about the account or about the list it came from. Most tools in this category are built to always produce a message - which is exactly how outbound stops being worth reading.
            </p>
            <p class="text-sm text-stone-500 dark:text-stone-400">
              HOLD is a quality gate, not a correctness guarantee. It reduces the chance of sending something unsupported. It cannot tell you a message is right.
            </p>
          </div>
        </div>
      </Reveal>

      <!-- Refusals -->
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {
          refusals.map((r, i) => (
            <Reveal delay={i * 60} from="up">
