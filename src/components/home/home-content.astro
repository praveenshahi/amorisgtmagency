---
import { Icon } from "astro-icon/components";
import Reveal from "@components/reveal.astro";
import References from "@components/layout/references.astro";
import { getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;

/*
  The marquee above says where Praveen worked. This section says why that matters:
  each company maps to a pattern, and each pattern maps to something Amoris ships.
  `icon` is a simple-icons name where an official mark exists; otherwise the company
  name is set as a wordmark, matching the marquee treatment.
*/
const patterns = [
  {
    company: "Amazon",
    icon: "simple-icons:amazon",
    learned: "Infrastructure at scale",
    detail: "Systems built for reliability, cost per call, and the thing that breaks at 2am - not the demo.",
    applied: "LangGraph reasoning chains with real error handling and state that survives failure.",
  },
  {
    company: "Meta",
    icon: "simple-icons:meta",
    learned: "Growth loops and measurement",
    detail: "Every funnel instrumented. Nothing shipped on a hunch, everything measured to basis points.",
    applied: "Clay enrichment waterfalls and qualification logic scored on evidence, not guesses.",
  },
  {
    company: "Great Learning",
    learned: "Revenue operations at scale",
    detail: "A 150-person sales organisation doing $120K+ per month in net-new, expanded into LATAM and Africa.",
    applied: "An audit method that finds where revenue leaks, and process design that scales without new headcount.",
  },
  {
    company: "Leverage Edu",
    learned: "Go-to-market and revenue models",
    detail: "Complex buyers, long cycles, and a motion built from zero to repeatable revenue.",
    applied: "SPIN and MEDDIC playbooks wired into the automation, so outbound argues instead of spamming.",
  },
];

const phases = [
  {
    n: "01",
    label: "Audit",
    icon: "heroicons:magnifying-glass",
    question: "Where is your pipeline actually leaking?",
    answer:
      "We map the go-to-market motion end to end: how leads arrive, where qualification happens or fails, and where people are doing work a system should do. You get a written map of the problems either way - the audit stands on its own.",
    duration: "1-2 hours",
  },
  {
    n: "02",
    label: "Design",
    icon: "heroicons:squares-plus",
    question: "How do you build something you actually own?",
    answer:
      "We design the orchestrated system against your workflow: LangGraph for reasoning, Clay for enrichment, n8n for orchestration, PostgreSQL for state. Every decision traces back to a problem from the audit. You review it, and you own the architecture.",
    duration: "1-2 weeks",
  },
  {
    n: "03",
    label: "Deploy",
    icon: "heroicons:rocket-launch",
    question: "What keeps it working after launch?",
    answer:
      "It ships self-hosted on your infrastructure and runs continuously. We measure against production data, tune the logic, and hand over documentation and training. Not a project that ends - a system your team keeps.",
    duration: "2-4 weeks, then ongoing",
  },
];

const cases = [
  {
    headline: "Scaling outbound with zero new headcount",
    problem: "B2B SaaS with three SDRs and no qualification process. Forty percent of leads were lost on the first call to a profile that was never a fit.",
    solution: "A LangGraph voice agent plus a Clay enrichment layer. Qualification, call logging and CRM sync stopped being manual.",
    result: "Sixty percent more qualified leads. SDR time moved from qualification to strategy. No new hires, same budget.",
    metric: "60% more qualified",
  },
  {
    headline: "Turning raw lists into qualified opportunities",
    problem: "List imports were manual and error-prone. No waterfall enrichment, and cold outreach was bouncing hard.",
    solution: "Multi-step Clay enrichment - company size, tech stack, recent funding - feeding an n8n webhook that scores into the CRM.",
    result: "Ninety percent data accuracy and a 3.5x cold reply rate. List quality turned into an advantage instead of a tax.",
    metric: "3.5x reply rate",
  },
  {
    headline: "Building the automation layer from scratch",
    problem: "A growing startup running twelve disconnected tools with no data flowing between them and no GTM infrastructure.",
    solution: "End-to-end orchestration: LangGraph for multi-step qualification, n8n for routing, PostgreSQL for conversation memory.",
    result: "One source of truth and 10x faster qualification, self-hosted and owned outright by the customer.",
    metric: "10x faster",
  },
];

const stack = [
  {
    name: "LangGraph",
    icon: "heroicons:cpu-chip",
    text: "Multi-step reasoning chains for qualification logic. Not one-shot API calls - agents that reason, adapt and refine.",
  },
  {
    name: "Clay + LLM waterfall",
    icon: "heroicons:funnel",
    text: "Deterministic enrichment first, then an LLM for intent signals and personalisation. Highest accuracy at the lowest cost per record.",
  },
  {
    name: "n8n orchestration",
    icon: "heroicons:arrows-right-left",
    text: "Real-time triggers and event-driven workflows that connect the whole GTM stack without a pile of custom glue code.",
  },
];

const sdrFeatures = [
  {
    title: "Evidence discipline",
    text: "Every claim traces to a cited source. A hypothesis is framed as curiosity, never as a diagnosis it cannot support.",
  },
  {
    title: "HOLD is a feature",
    text: "Most AI sales tools always send. This one knows when not to, and tells you why it stopped.",
  },
  {
    title: "Signal-first, not template-first",
    text: "The argument changes per company, not just the merge field with their name in it.",
  },
  {
    title: "Human in the loop",
    text: "It researches and drafts. You send. Judgment stays where it belongs.",
  },
];

/*
  Build layer first, then the GTM tools we connect to - the ordering carries both
  categories in one row. Everything here is either already named in the site copy or
  reachable through n8n, so the row is a claim we can stand behind.
*/
const tools = [
  { name: "simple-icons:openai", label: "OpenAI" },
  { name: "simple-icons:anthropic", label: "Anthropic" },
  { name: "simple-icons:langgraph", label: "LangGraph" },
  { name: "simple-icons:n8n", label: "n8n" },
  { name: "simple-icons:postgresql", label: "PostgreSQL" },
  { label: "Clay" },
  { name: "simple-icons:hubspot", label: "HubSpot" },
  { name: "simple-icons:salesforce", label: "Salesforce" },
  { name: "simple-icons:slack", label: "Slack" },
  { name: "simple-icons:gmail", label: "Gmail" },
  { name: "simple-icons:googlesheets", label: "Google Sheets" },
  { name: "simple-icons:notion", label: "Notion" },
  { name: "simple-icons:airtable", label: "Airtable" },
  { name: "simple-icons:zapier", label: "Zapier" },
  { name: "simple-icons:make", label: "Make" },
  { name: "simple-icons:calendly", label: "Calendly" },
  { name: "simple-icons:twilio", label: "Twilio" },
  { name: "simple-icons:stripe", label: "Stripe" },
];

const mcpWhatsApp = 'https://wa.me/919100933191?text=' + encodeURIComponent('I would like early access to the Amoris AI SDR MCP server.');

const productsUrl = getLocaleUrl('products', locale);
const pricingUrl = getLocaleUrl('pricing', locale);
const founderUrl = getLocaleUrl('founder', locale);
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- ── Why the background matters ── -->
  <div class="graph-paper-bg-outer">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-patterns-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Why these patterns matter</span>
          <h2 id="home-patterns-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">Most GTM engineers configure tools. We architect the systems.</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Ten years carrying a revenue number, then three years shipping production AI. Each place taught a pattern, and every pattern is in what Amoris builds.
          </p>
        </Reveal>

        <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2">
          {
            patterns.map((p, i) => (
              <Reveal as="li" delay={i * 70} from="up" class="m-0">
                <article class="group relative flex h-full flex-col gap-4 overflow-hidden rounded-xl border border-stone-300 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-xl dark:border-stone-700 dark:bg-stone-900">
                  <div class="bg-primary absolute inset-x-0 top-0 h-1" />
                  <div class="flex h-8 items-center gap-2.5 text-xl font-semibold tracking-tight">
                    {p.icon && <Icon name={p.icon} class="h-6 w-6 shrink-0" aria-hidden="true" />}
                    {p.company}
                  </div>
                  <h3 class="text-lg font-bold">{p.learned}</h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{p.detail}</p>
                  <p class="mt-auto border-t border-stone-200 pt-4 text-sm leading-relaxed text-stone-700 dark:border-stone-700 dark:text-stone-200">
                    <span class="text-primary dark:text-primary-light font-semibold">Applied: </span>
                    {p.applied}
                  </p>
                </article>
              </Reveal>
            ))
          }
        </ul>

        <Reveal class="mt-8 flex justify-center">
          <a href={founderUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>Read the full story</span>
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
        </Reveal>
      </section>
    </div>
  </div>

  <!-- ── How we work ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-process-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">How we build it</span>
        <h2 id="home-process-heading" class="text-3xl font-bold sm:text-4xl">Three phases. One system you own.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          The phases run concurrently, which is how a production system lands in six weeks instead of six months.
        </p>
      </Reveal>

      <ol class="m-0 flex list-none flex-col gap-5 p-0">
        {
          phases.map((phase, i) => (
            <Reveal as="li" delay={i * 70} from="up" class="m-0">
              <article class="hover:border-primary dark:hover:border-primary-light flex h-full flex-col gap-5 rounded-xl border border-stone-300 bg-white p-6 transition-all hover:shadow-lg sm:flex-row sm:gap-8 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
                <div class="flex shrink-0 items-center gap-4 sm:w-44 sm:flex-col sm:items-start sm:gap-3">
                  <span class="text-primary dark:text-primary-light font-mono text-3xl font-bold tabular-nums">{phase.n}</span>
                  <div class="flex flex-col gap-1">
                    <span class="flex items-center gap-2 text-lg font-bold">
                      <Icon name={phase.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                      {phase.label}
                    </span>
                    <span class="font-mono text-xs tracking-wide text-stone-500 uppercase dark:text-stone-400">{phase.duration}</span>
                  </div>
                </div>
                <div class="flex flex-col gap-2">
                  <h3 class="text-base font-bold">{phase.question}</h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{phase.answer}</p>
                </div>
              </article>
            </Reveal>
          ))
        }
      </ol>

      <Reveal class="mt-8 flex justify-center">
        <a href={pricingUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
          <span>Compare the two engagement models</span>
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
        </a>
      </Reveal>
    </section>
  </div>

  <!-- ── Results ── -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-cases-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Results in production</span>
          <h2 id="home-cases-heading" class="text-3xl font-bold sm:text-4xl">Real systems, running now.</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Client names are withheld under agreement. The problems, the builds and the numbers are not.
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          {
            cases.map((c, i) => (
              <Reveal delay={i * 70} from="up">
                <article class="flex h-full flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                  <h3 class="text-lg font-bold text-balance">{c.headline}</h3>
                  <div class="flex flex-col gap-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                    <p>
                      <span class="text-primary dark:text-primary-light font-mono text-xs font-semibold tracking-wider uppercase">Problem<br /></span>
                      {c.problem}
                    </p>
                    <p>
                      <span class="text-primary dark:text-primary-light font-mono text-xs font-semibold tracking-wider uppercase">Build<br /></span>
                      {c.solution}
                    </p>
                    <p>
                      <span class="text-primary dark:text-primary-light font-mono text-xs font-semibold tracking-wider uppercase">Result<br /></span>
                      {c.result}
                    </p>
                  </div>
                  <span class="border-primary/30 text-primary dark:text-primary-light mt-auto w-fit rounded-full border px-3 py-1 font-mono text-xs font-semibold">{c.metric}</span>
                </article>
              </Reveal>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <!-- ── Stack ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-stack-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Production-grade architecture</span>
        <h2 id="home-stack-heading" class="text-3xl font-bold sm:text-4xl">The stack that scales.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Named explicitly, because you should be able to check the work and hire against it later.
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          stack.map((s, i) => (
            <Reveal delay={i * 70} from="up">
              <article class="flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                <span class="bg-primary-light/15 text-primary dark:bg-primary-darker dark:text-primary-light flex h-11 w-11 items-center justify-center rounded-lg">
                  <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="text-lg font-bold">{s.name}</h3>
                <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{s.text}</p>
              </article>
            </Reveal>
          ))
        }
      </div>

      <Reveal class="mt-6 text-center text-sm text-stone-500 dark:text-stone-400">
        <p>PostgreSQL for state and memory. Retell and ElevenLabs for voice. All of it self-hosted on your infrastructure and owned by you.</p>
      </Reveal>
    </section>
  </div>

  <!-- ── What we build on, and what we plug into ── -->
  <References marks={tools} label="Powered by, and plugs into your stack" reverse>
    <p class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-x-2 gap-y-1 px-6 pb-10 text-center text-sm text-white/60">
      <span>An MCP server for the Amoris AI SDR is coming.</span>
      <a href={mcpWhatsApp} target="_blank" rel="noopener" class="group inline-flex items-center gap-1 font-semibold text-white underline underline-offset-4 hover:text-white/80">
        Ask about early access
        <Icon name="heroicons:arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </p>
  </References>

  <!-- ── Flagship product ── -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section id="amoris-ai-sdr" aria-labelledby="home-sdr-heading">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Flagship product</span>
          <h2 id="home-sdr-heading" class="text-3xl font-bold sm:text-4xl">Amoris AI SDR</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Give it a company name. It researches live, forms a commercial hypothesis, writes an evidence-backed email and judges its own output - in about 38 seconds. Then you decide: send or skip.
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
          <Reveal from="left">
            <ol class="m-0 flex h-full list-none flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
              <li class="m-0 flex gap-4">
                <span class="bg-primary flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-mono text-xs font-bold text-white">1</span>
                <span class="flex flex-col gap-1">
                  <span class="font-bold">Research</span>
                  <span class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">Live web research per company, returned as structured GTM analysis with evidence URLs attached.</span>
                </span>
              </li>
              <li class="m-0 flex gap-4">
                <span class="bg-primary flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-mono text-xs font-bold text-white">2</span>
                <span class="flex flex-col gap-1">
                  <span class="font-bold">Reason</span>
                  <span class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">Forms a testable hypothesis about their motion, matches it against real experience, and writes the email.</span>
                </span>
              </li>
              <li class="m-0 flex gap-4">
                <span class="bg-primary flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-mono text-xs font-bold text-white">3</span>
                <span class="flex flex-col gap-1">
                  <span class="font-bold">Judge</span>
                  <span class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">Independently scores its own draft against 14 quality criteria. Ready to send, or HOLD with a stated reason.</span>
                </span>
              </li>
            </ol>
          </Reveal>

          <Reveal from="right">
            <div class="border-primary/30 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 flex h-full flex-col gap-4 rounded-xl border-2 bg-linear-to-br via-white p-6 sm:p-8 dark:via-stone-900">
              <h3 class="text-lg font-bold">Why it is different</h3>
              <ul class="m-0 flex list-none flex-col gap-3 p-0">
                {
                  sdrFeatures.map((f) => (
                    <li class="m-0 flex gap-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                      <Icon name="heroicons:check-circle" class="text-primary dark:text-primary-light mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
                      <span>
                        <span class="font-semibold text-stone-900 dark:text-white">{f.title}. </span>
                        {f.text}
                      </span>
                    </li>
                  ))
                }
              </ul>
              <a href="https://wa.me/919100933191?text=Tell%20me%20about%20Amoris%20AI%20SDR" target="_blank" rel="noopener" class="btn-primary mt-auto w-fit">Ask about Amoris AI SDR</a>
            </div>
          </Reveal>
        </div>
      </section>
    </div>
  </div>

  <!-- ── Fit ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-fit-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Who this is for</span>
        <h2 id="home-fit-heading" class="text-3xl font-bold sm:text-4xl">We would rather tell you early.</h2>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <Reveal from="left">
          <div class="flex h-full flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:check-circle" class="h-6 w-6 shrink-0 text-green-600 dark:text-green-400" aria-hidden="true" />
              A fit
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">Series A or B B2B SaaS, roughly 5 to 50 people</li>
              <li class="m-0">An outbound motion that works but will not scale</li>
              <li class="m-0">No dedicated GTM infrastructure yet</li>
              <li class="m-0">Willing to own the system after handover</li>
            </ul>
          </div>
        </Reveal>
        <Reveal from="right">
          <div class="flex h-full flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:x-circle" class="h-6 w-6 shrink-0 text-stone-400" aria-hidden="true" />
              Not a fit
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">Pre-product companies with no motion to automate</li>
              <li class="m-0">Enterprises needing procurement-length timelines</li>
              <li class="m-0">Teams looking for a no-code tool rather than a systems partner</li>
              <li class="m-0">Anyone wanting to outsource judgment entirely</li>
            </ul>
          </div>
        </Reveal>
      </div>
    </section>
  </div>

  <!-- ── CTA ── -->
  <div class="container mx-auto pb-20">
    <div class="cta-band border-primary/20 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 relative overflow-hidden rounded-2xl border-4 bg-linear-to-br via-white px-6 py-12 text-center sm:px-12 dark:via-stone-900">
      <div class="cta-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto flex max-w-2xl flex-col items-center gap-4">
        <h2 class="text-3xl font-bold text-balance sm:text-4xl">Start with the audit. Keep the map either way.</h2>
        <p class="max-w-xl text-stone-600 dark:text-stone-300">
          Twenty minutes on your actual motion - no deck, no discovery theatre. You leave with a written view of where the pipeline leaks, whether or not we build it.
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
          <a href="https://calendly.com/praveenshahi13/30min" target="_blank" rel="noopener" class="btn-primary group">
            Book the audit
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
          <a href={productsUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>See what we ship</span>
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/tailwind.config.css";

  /* ── CTA glow ── */
  .cta-glow {
    background: radial-gradient(ellipse at 50% 0%, rgba(67, 97, 255, 0.18) 0%, transparent 60%);
  }
