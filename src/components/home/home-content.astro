---
import { Icon } from "astro-icon/components";
import Reveal from "@components/reveal.astro";
import References from "@components/layout/references.astro";
import { getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;

/*
  Copy discipline for this file, from the pre-copy contradiction audit:
  - The research layer is deployed. The outbound reasoning layer is built but in
    private testing. Both states are stated, never blurred.
  - No reply rates, pipeline figures or client outcomes appear here. None have been
    measured for this system, and there are no client engagements yet.
  - First person. Amoris is a founder-led practice, not a staffed company.
*/

const pipeline = [
  {
    n: "01",
    label: "Research",
    icon: "heroicons:magnifying-glass",
    text: "Live web research on one account, returned as a structured read: what the company actually did, said, built or hired for, with the source behind each observation.",
  },
  {
    n: "02",
    label: "Reason",
    icon: "heroicons:light-bulb",
    text: "The strongest signal becomes a commercial interpretation and one testable hypothesis, matched against real experience. If nothing credible connects, it stops here.",
  },
  {
    n: "03",
    label: "Judge",
    icon: "heroicons:scale",
    text: "The draft is checked against 14 quality checks covering whether claims trace to evidence, whether inference is marked as inference, and whether anything about the company was invented.",
  },
  {
    n: "04",
    label: "You decide",
    icon: "heroicons:hand-raised",
    text: "Output is a file you read. Nothing is connected to your inbox and nothing is sent. Sending is optional, manual and yours.",
  },
];

const refusals = [
  {
    title: "It will not manufacture confidence",
    text: "If the evidence does not support a commercial argument, it stops and says why. It does not produce a message because a message was expected.",
  },
  {
    title: "It will not present a guess as a fact",
    text: "Anything resting on inference is written as curiosity, not diagnosis. The output keeps the two apart on purpose.",
  },
  {
    title: "It does not know who will buy",
    text: "It assesses whether there is a defensible reason to start a conversation. That is a smaller and more honest question than intent scoring.",
  },
  {
    title: "It does not replace your judgement",
    text: "It removes the research and first-draft work. The decision to contact someone stays with the person whose name is on the message.",
  },
];

const phases = [
  {
    n: "01",
    label: "Audit",
    icon: "heroicons:magnifying-glass",
    question: "Where is the motion actually losing time?",
    answer:
      "I map the go-to-market motion end to end: how accounts arrive, where qualification happens or fails, and where people are doing work a system should do. The output is a written diagnostic you keep.",
    duration: "2-3 days",
  },
  {
    n: "02",
    label: "Design",
    icon: "heroicons:squares-plus",
    question: "How do you build something you can keep?",
    answer:
      "I design the system against your workflow and your existing stack, and the design traces back to problems named in the audit. You review it before anything gets built.",
    duration: "Scoped from the audit",
  },
  {
    n: "03",
    label: "Deploy",
    icon: "heroicons:rocket-launch",
    question: "What happens after it ships?",
    answer:
      "It runs on your infrastructure. I tune it against real usage, then hand over documentation and training so your team can change it without me.",
    duration: "Scoped from the audit",
  },
];

/*
  Two categories, deliberately kept apart. The research engine runs on the first
  group. The second group is what I build and integrate with on client engagements -
  it is not what the research engine is made of.
*/
const engineTools = [
  { name: "simple-icons:langgraph", label: "LangGraph" },
  { name: "simple-icons:openai", label: "OpenAI" },
  { name: "simple-icons:anthropic", label: "Anthropic" },
  { name: "simple-icons:fastapi", label: "FastAPI" },
];

const deliveryTools = [
  { name: "simple-icons:n8n", label: "n8n" },
  { label: "Clay" },
  { name: "simple-icons:postgresql", label: "PostgreSQL" },
  { name: "simple-icons:hubspot", label: "HubSpot" },
  { name: "simple-icons:salesforce", label: "Salesforce" },
  { name: "simple-icons:slack", label: "Slack" },
  { name: "simple-icons:gmail", label: "Gmail" },
  { name: "simple-icons:googlesheets", label: "Google Sheets" },
  { name: "simple-icons:notion", label: "Notion" },
  { name: "simple-icons:airtable", label: "Airtable" },
  { name: "simple-icons:zapier", label: "Zapier" },
  { name: "simple-icons:make", label: "Make" },
  { name: "simple-icons:calendly", label: "Calendly" },
];

const mcpWhatsApp = 'https://wa.me/919100933191?text=' + encodeURIComponent('I would like early access to the Amoris research engine MCP server.');
const auditWhatsApp = 'https://wa.me/919100933191?text=' + encodeURIComponent('I am interested in the paid GTM Audit.');

const productsUrl = getLocaleUrl('products', locale);
const pricingUrl = getLocaleUrl('pricing', locale);
const founderUrl = getLocaleUrl('founder', locale);
const architectureUrl = getLocaleUrl('architecture', locale);
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- ── The decision problem ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-problem-heading">
      <Reveal class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The problem</span>
        <h2 id="home-problem-heading" class="text-3xl font-bold text-balance sm:text-4xl">Outbound rarely fails at sending. It fails at deciding what to say.</h2>
        <p class="text-lg leading-relaxed text-stone-600 dark:text-stone-300">
          Finding the one thing worth saying about an account takes real time and real judgement. It is the step that scales worst, so it is the step that gets skipped - and skipping it is what turns outbound into volume nobody wants to receive.
        </p>
        <p class="leading-relaxed text-stone-600 dark:text-stone-300">
          Amoris is a founder-led AI GTM practice run by Praveen Shahi. It starts at that decision, not at the send button.
        </p>
      </Reveal>
    </section>
  </div>

  <!-- ── The wedge: evidence-led research ── -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section id="research-engine" aria-labelledby="home-engine-heading" class="scroll-mt-28">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The wedge</span>
          <h2 id="home-engine-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">Evidence-led account research, and a system that knows when to stop.</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Give it one company. It researches the account live, works out whether there is a defensible reason to start a conversation, and hands you a read you can act on. The research is worth having whether or not anything gets sent.
          </p>
        </Reveal>

        <ol class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2">
          {
            pipeline.map((step, i) => (
              <Reveal as="li" delay={i * 60} from="up" class="m-0">
                <article class="flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                  <div class="flex items-center gap-3">
                    <span class="text-primary dark:text-primary-light font-mono text-2xl font-bold tabular-nums">{step.n}</span>
                    <span class="flex items-center gap-2 text-lg font-bold">
                      <Icon name={step.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                      {step.label}
                    </span>
                  </div>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{step.text}</p>
                </article>
              </Reveal>
            ))
          }
        </ol>

        <!-- HOLD -->
        <Reveal class="mt-8">
          <div class="border-primary/30 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 rounded-xl border-2 bg-linear-to-br via-white p-6 sm:p-8 dark:via-stone-900">
            <div class="flex flex-col gap-3">
              <h3 class="flex items-center gap-2 text-xl font-bold">
                <Icon name="heroicons:hand-raised" class="text-primary dark:text-primary-light h-6 w-6 shrink-0" aria-hidden="true" />
                HOLD is the point, not the exception
              </h3>
              <p class="leading-relaxed text-stone-600 dark:text-stone-300">
                The pipeline can stop at two places. It stops before writing anything if the evidence will not support a credible commercial argument. It stops after writing if a claim about the company cannot be traced back to the research. Either way it tells you which, and why.
              </p>
              <p class="leading-relaxed text-stone-600 dark:text-stone-300">
                A HOLD is not a failure state. It usually says something true about the account or about the list it came from. Most tools in this category are built to always produce a message - which is exactly how outbound stops being worth reading.
              </p>
              <p class="text-sm text-stone-500 dark:text-stone-400">
                HOLD is a quality gate, not a correctness guarantee. It reduces the chance of sending something unsupported. It cannot tell you a message is right.
              </p>
            </div>
          </div>
        </Reveal>

        <!-- Refusals -->
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            refusals.map((r, i) => (
              <Reveal delay={i * 60} from="up">
                <div class="flex h-full flex-col gap-2 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                  <h3 class="flex items-start gap-2 text-base font-bold">
                    <Icon name="heroicons:x-circle" class="mt-0.5 h-5 w-5 shrink-0 text-stone-400" aria-hidden="true" />
                    {r.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{r.text}</p>
                </div>
              </Reveal>
            ))
          }
        </div>

        <Reveal class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={architectureUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>How it works, in detail</span>
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
        </Reveal>
      </section>
    </div>
  </div>

  <!-- ── What exists today ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-status-heading">
      <Reveal class="mb-10 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Where this actually is</span>
        <h2 id="home-status-heading" class="text-3xl font-bold sm:text-4xl">Built today, and being extended.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Stated plainly, because you will ask on the first call anyway.
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <Reveal from="left">
          <div class="flex h-full flex-col gap-3 rounded-xl border-2 border-green-600/40 bg-white p-6 sm:p-8 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:check-circle" class="h-6 w-6 shrink-0 text-green-600 dark:text-green-400" aria-hidden="true" />
              Running
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">The research and account-analysis layer, deployed and reachable as an API</li>
              <li class="m-0">Evidence captured with the source behind each observation</li>
              <li class="m-0"><a href="https://www.npmjs.com/package/intel-echo" target="_blank" rel="noopener">intel-echo</a>, published on npm - auditing where an AI's reasoning exceeded its mandate</li>
            </ul>
          </div>
        </Reveal>
        <Reveal from="right">
          <div class="flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:beaker" class="h-6 w-6 shrink-0 text-stone-400" aria-hidden="true" />
              In private testing
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">The outbound reasoning layer - hypothesis, message angle, the judge and HOLD</li>
              <li class="m-0">Built and running locally, tested against a small number of real accounts</li>
              <li class="m-0">Not yet deployed alongside the research layer, and not sold as a finished product</li>
            </ul>
            <p class="mt-auto pt-2 text-sm text-stone-500 dark:text-stone-400">
              If you want to see it, the honest version is a live run on one of your accounts rather than a demo.
            </p>
          </div>
        </Reveal>
      </div>
    </section>
  </div>

  <!-- ── Paid GTM Audit ── -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section id="gtm-audit" aria-labelledby="home-audit-heading" class="scroll-mt-28">
        <div class="border-primary/30 mx-auto flex max-w-3xl flex-col gap-5 rounded-2xl border-2 bg-white p-6 sm:p-10 dark:bg-stone-900">
          <Reveal class="flex flex-col gap-3">
            <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Where an engagement starts</span>
            <h2 id="home-audit-heading" class="text-3xl font-bold sm:text-4xl">The GTM Audit</h2>
            <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-primary dark:text-primary-light text-3xl font-bold">₹15,000</span>
              <span class="text-stone-500 dark:text-stone-400">· 2-3 days · written diagnostic</span>
            </p>
            <p class="leading-relaxed text-stone-600 dark:text-stone-300">
              A paid, written diagnostic of your go-to-market motion. It names where the workflow bottlenecks, where research and qualification are breaking down, which parts are genuinely worth automating, and what a sensible first pilot would cover.
            </p>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0 flex gap-2">
                <Icon name="heroicons:check-circle" class="text-primary dark:text-primary-light mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
                <span>You keep the document, and it is useful whether or not anything follows.</span>
              </li>
              <li class="m-0 flex gap-2">
                <Icon name="heroicons:check-circle" class="text-primary dark:text-primary-light mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
                <span>It is a diagnostic, not an implementation. Building is scoped separately.</span>
              </li>
              <li class="m-0 flex gap-2">
                <Icon name="heroicons:check-circle" class="text-primary dark:text-primary-light mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
                <span>No revenue promises. It tells you where the time goes and what to do about it.</span>
              </li>
            </ul>
            <div class="mt-2 flex flex-wrap gap-3">
              <a href={auditWhatsApp} target="_blank" rel="noopener" class="btn-primary">Book the GTM Audit</a>
              <a href="https://calendly.com/praveenshahi13/30min" target="_blank" rel="noopener" class="btn-subtle rounded px-4 py-[0.43rem]">Free intro call first</a>
            </div>
            <p class="text-sm text-stone-500 dark:text-stone-400">
              The intro call is free and short. Its only job is to work out whether an audit is worth doing at all.
            </p>
          </Reveal>
        </div>
      </section>
    </div>
  </div>

  <!-- ── The wider practice ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-practice-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The wider practice</span>
        <h2 id="home-practice-heading" class="text-3xl font-bold sm:text-4xl">Research is the wedge. The systems work is broader.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Beyond the research engine, I design and build the automation layer around a revenue team - on the stack you already run.
        </p>
      </Reveal>

      <ol class="m-0 flex list-none flex-col gap-5 p-0">
        {
          phases.map((phase, i) => (
            <Reveal as="li" delay={i * 70} from="up" class="m-0">
              <article class="hover:border-primary dark:hover:border-primary-light flex h-full flex-col gap-5 rounded-xl border border-stone-300 bg-white p-6 transition-all hover:shadow-lg sm:flex-row sm:gap-8 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
                <div class="flex shrink-0 items-center gap-4 sm:w-44 sm:flex-col sm:items-start sm:gap-3">
                  <span class="text-primary dark:text-primary-light font-mono text-3xl font-bold tabular-nums">{phase.n}</span>
                  <div class="flex flex-col gap-1">
                    <span class="flex items-center gap-2 text-lg font-bold">
                      <Icon name={phase.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                      {phase.label}
                    </span>
                    <span class="font-mono text-xs tracking-wide text-stone-500 uppercase dark:text-stone-400">{phase.duration}</span>
                  </div>
                </div>
                <div class="flex flex-col gap-2">
                  <h3 class="text-base font-bold">{phase.question}</h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{phase.answer}</p>
                </div>
              </article>
            </Reveal>
          ))
        }
      </ol>

      <Reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={pricingUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
          <span>Compare the two engagement models</span>
          <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
        </a>
      </Reveal>
    </section>
  </div>

  <!-- ── What the engine runs on ── -->
  <References marks={engineTools} label="What the research engine runs on" />

  <!-- ── What I build and integrate with ── -->
  <References marks={deliveryTools} label="What I build with, and integrate into, on client engagements" reverse>
    <p class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-x-2 gap-y-1 px-6 pb-10 text-center text-sm text-white/60">
      <span>An MCP server for the research engine is coming.</span>
      <a href={mcpWhatsApp} target="_blank" rel="noopener" class="group inline-flex items-center gap-1 font-semibold text-white underline underline-offset-4 hover:text-white/80">
        Ask about early access
        <Icon name="heroicons:arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </p>
  </References>

  <!-- ── Fit ── -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-fit-heading">
      <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Who this is for</span>
        <h2 id="home-fit-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">Built for teams where outbound still carries someone's name.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Not a stage or a headcount band. What matters is whether the quality of the message still matters to the person sending it.
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <Reveal from="left">
          <div class="flex h-full flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:check-circle" class="h-6 w-6 shrink-0 text-green-600 dark:text-green-400" aria-hidden="true" />
              A fit
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">Founders still doing their own outbound</li>
              <li class="m-0">Lean GTM teams where one person carries research and messaging</li>
              <li class="m-0">Teams where the sender's own name is on the message</li>
              <li class="m-0">Teams that draft more than they send, because quality is the constraint</li>
              <li class="m-0">Account research and commercial judgement still done by hand</li>
              <li class="m-0">High-value B2B, where one good conversation is worth the work</li>
            </ul>
          </div>
        </Reveal>
        <Reveal from="right">
          <div class="flex h-full flex-col gap-4 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:x-circle" class="h-6 w-6 shrink-0 text-stone-400" aria-hidden="true" />
              Not a fit
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">Teams that want volume regardless of whether the evidence supports the message</li>
              <li class="m-0">Anyone looking for autonomous sending - the send stays manual by design</li>
              <li class="m-0">Teams wanting a sequencer, a CRM or a data enrichment tool</li>
              <li class="m-0">Anyone who wants to hand over the judgement entirely</li>
            </ul>
            <p class="mt-auto pt-2 text-sm text-stone-500 dark:text-stone-400">
              That first line is the real exclusion. Everything else is a scope question.
            </p>
          </div>
        </Reveal>
      </div>
    </section>
  </div>

  <!-- ── CTA ── -->
  <div class="container mx-auto pb-20">
    <div class="cta-band border-primary/20 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 relative overflow-hidden rounded-2xl border-4 bg-linear-to-br via-white px-6 py-12 text-center sm:px-12 dark:via-stone-900">
      <div class="cta-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto flex max-w-2xl flex-col items-center gap-4">
        <h2 class="text-3xl font-bold text-balance sm:text-4xl">Start with the audit, or just start with a call.</h2>
        <p class="max-w-xl text-stone-600 dark:text-stone-300">
          The intro call is free and exists to find out whether any of this applies to you. The audit is paid, takes two to three days, and leaves you with a written diagnostic either way.
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
          <a href={auditWhatsApp} target="_blank" rel="noopener" class="btn-primary group">
            Book the GTM Audit
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
          <a href="https://calendly.com/praveenshahi13/30min" target="_blank" rel="noopener" class="btn-subtle rounded px-4 py-[0.43rem]">Free intro call</a>
          <a href={productsUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>See what exists</span>
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
        </div>
        <p class="text-sm text-stone-500 dark:text-stone-400">
          Or read the <a href={founderUrl}>background behind it</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/tailwind.config.css";

