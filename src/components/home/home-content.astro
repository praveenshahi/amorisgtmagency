---
import { Icon } from "astro-icon/components";
import Reveal from "@components/reveal.astro";
import References from "@components/layout/references.astro";
import { getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;

/*
  Copy discipline for this file. See AGENTS.md for the full voice specification.
  - The research layer is deployed. The outbound reasoning layer is built but in
    private testing. Both states are stated, never blurred.
  - No reply rates, pipeline figures or client outcomes appear here. None have been
    measured for this system, and there are no client engagements yet.
  - First person. Amoris is a founder-led practice, not a staffed company.
  - Nine sections, hard ceiling. Anything new displaces something.
  - Exactly one rendered process diagram on this page: the method chain in section 7.
    The pipeline and ladder below render as cards and lists, deliberately.
*/

const pipeline = [
  {
    n: "01",
    label: "Research",
    icon: "heroicons:magnifying-glass",
    text: "Live web research on one account, returned as a structured read: what the company actually did, said, built or hired for, with the source behind each observation.",
  },
  {
    n: "02",
    label: "Reason",
    icon: "heroicons:light-bulb",
    text: "The strongest signal becomes a commercial interpretation and one testable hypothesis, matched against real experience. If nothing credible connects, it stops here.",
  },
  {
    n: "03",
    label: "Judge",
    icon: "heroicons:scale",
    text: "The draft is checked against a fixed set of quality checks covering whether claims trace to evidence, whether inference is marked as inference, and whether anything about the company was invented.",
  },
  {
    n: "04",
    label: "You decide",
    icon: "heroicons:hand-raised",
    text: "Output is a file you read. Nothing is connected to your inbox and nothing is sent. Sending is optional, manual and yours.",
  },
];

const refusals = [
  {
    title: "It will not manufacture confidence",
    text: "If the evidence does not support a commercial argument, it stops and says why. It does not produce a message because a message was expected.",
  },
  {
    title: "It will not present a guess as a fact",
    text: "Anything resting on inference is written as curiosity, not diagnosis. The output keeps the two apart on purpose.",
  },
  {
    title: "It does not know who will buy",
    text: "It assesses whether there is a defensible reason to start a conversation. That is a smaller and more honest question than intent scoring.",
  },
  {
    title: "It does not replace your judgement",
    text: "It removes the research and first-draft work. The decision to contact someone stays with the person whose name is on the message.",
  },
];

/*
  The one rendered process diagram on this page. Every engagement runs this
  sequence, whatever the motion. Kept to six steps so it reads in one pass.
*/
const method = [
  { label: "Diagnose", icon: "heroicons:magnifying-glass", text: "Map the motion end to end and find where the decision breaks." },
  { label: "Design", icon: "heroicons:squares-plus", text: "Design against your workflow and the stack you already run." },
  { label: "Build", icon: "heroicons:wrench-screwdriver", text: "Build the smallest thing that tests the diagnosis." },
  { label: "Test", icon: "heroicons:beaker", text: "Run it on real accounts, not a sandbox." },
  { label: "Measure", icon: "heroicons:chart-bar", text: "Against a baseline captured before anything changed." },
  { label: "Learn", icon: "heroicons:arrow-path", text: "Keep what held up. Cut what did not. Then widen." },
];

/*
  The commercial ladder renders as a list, not a diagram. The audit figure is the
  currently published range and appears identically on /pricing, in the two FAQ
  answers and in theme.config.ts. Change all five together or not at all.
*/
const ladder = [
  {
    n: "01",
    name: "GTM Audit",
    price: "₹15,000 – ₹25,000",
    note: "+ GST · 2-3 days",
    text: "A paid, written diagnostic of how your go-to-market motion actually runs. It names where the workflow bottlenecks, where research and qualification break down, which parts are genuinely worth handing to a system, and what a sensible first pilot would cover.",
    limit: "It is a diagnostic, not an implementation. It makes no revenue promises. You keep the document whether or not anything follows.",
  },
  {
    n: "02",
    name: "First paid pilot",
    price: "₹1.5L – ₹3L",
    note: "scoped from the audit",
    text: "One motion, one cohort, one question worth answering. Research and evidence gathering run on the Amoris engine. Review, sending and response handling stay deliberate and human, on your infrastructure and your domain.",
    limit: "The deliverable is evidence, not volume. The baseline gets captured before the pilot runs, because the before-state can only be measured once.",
  },
  {
    n: "03",
    name: "Ongoing partnership",
    price: "Scoped",
    note: "no rate card",
    text: "What the pilot proved, extended across more of the motion. Priced against scope once there is evidence about what actually moved.",
    limit: "Quoting this before anyone has looked at the motion is guessing, and you would be paying for the guess.",
  },
];

/*
  The three motions Amoris works on. Named because the failure mode is different
  in each one, and buyers self-identify by stage faster than by headcount.
*/
const motions = [
  {
    stage: "0 → 1",
    title: "No repeatable motion yet",
    text: "Founder-led sales that works but cannot be handed over. The job is finding which segment and which message actually hold, before hiring against a guess.",
  },
  {
    stage: "1 → 10",
    title: "One motion that needs to survive other people running it",
    text: "The founder's judgement is the system. The job is getting it out of their head and into something a second and third person can run without quality collapsing.",
  },
  {
    stage: "10 → 100",
    title: "A motion that works but is drowning in manual work",
    text: "Research and qualification are being redone by hand at volume. The job is deciding what is genuinely worth handing to a system, and what is a process problem wearing an automation costume.",
  },
];

const engineTools = [
  { name: "simple-icons:langgraph", label: "LangGraph" },
  { name: "simple-icons:openai", label: "OpenAI" },
  { name: "simple-icons:anthropic", label: "Anthropic" },
  { name: "simple-icons:fastapi", label: "FastAPI" },
];

const auditWhatsApp = 'https://wa.me/919100933191?text=' + encodeURIComponent('I am interested in the paid GTM Audit.');

const productsUrl = getLocaleUrl('products', locale);
const pricingUrl = getLocaleUrl('pricing', locale);
const founderUrl = getLocaleUrl('founder', locale);
const architectureUrl = getLocaleUrl('architecture', locale);
const blogUrl = getLocaleUrl('blog', locale);
---

<section class="home-content flex flex-col overflow-x-clip">
  <!-- ════ 2. The problem ════ -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-problem-heading">
      <Reveal class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The problem</span>
        <h2 id="home-problem-heading" class="text-3xl font-bold text-balance sm:text-4xl">Outbound rarely fails at sending. It fails at deciding what to say.</h2>
        <p class="text-lg leading-relaxed text-stone-600 dark:text-stone-300">
          Finding the one thing worth saying about an account takes real time and real judgement. It is the step that scales worst, so it is the step that gets skipped - and skipping it is what turns outbound into volume nobody wants to receive.
        </p>
        <p class="leading-relaxed text-stone-600 dark:text-stone-300">
          Amoris is a founder-led AI GTM practice run by Praveen Shahi. It starts at that decision, not at the send button.
        </p>
      </Reveal>
    </section>
  </div>

  <!-- ════ 3. The wedge: evidence-led research ════ -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section id="research-engine" aria-labelledby="home-engine-heading" class="scroll-mt-28">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The wedge</span>
          <h2 id="home-engine-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">Evidence-led account research, and a system that knows when to stop.</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Give it one company. It researches the account live, works out whether there is a defensible reason to start a conversation, and hands you a read you can act on. The research is worth having whether or not anything gets sent.
          </p>
        </Reveal>

        <ol class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2">
          {
            pipeline.map((step, i) => (
              <Reveal as="li" delay={i * 60} from="up" class="m-0">
                <article class="flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                  <div class="flex items-center gap-3">
                    <span class="text-primary dark:text-primary-light font-mono text-2xl font-bold tabular-nums">{step.n}</span>
                    <span class="flex items-center gap-2 text-lg font-bold">
                      <Icon name={step.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                      {step.label}
                    </span>
                  </div>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{step.text}</p>
                </article>
              </Reveal>
            ))
          }
        </ol>

        <!-- HOLD -->
        <Reveal class="mt-8">
          <div class="border-primary/30 from-primary-light/10 to-secondary-light/10 dark:from-primary-darker/30 dark:to-secondary-dark/20 rounded-xl border-2 bg-linear-to-br via-white p-6 sm:p-8 dark:via-stone-900">
            <div class="flex flex-col gap-3">
              <h3 class="flex items-center gap-2 text-xl font-bold">
                <Icon name="heroicons:hand-raised" class="text-primary dark:text-primary-light h-6 w-6 shrink-0" aria-hidden="true" />
                HOLD is the point, not the exception
              </h3>
              <p class="leading-relaxed text-stone-600 dark:text-stone-300">
                The pipeline can stop at two places. It stops before writing anything if the evidence will not support a credible commercial argument. It stops after writing if a claim about the company cannot be traced back to the research. Either way it tells you which, and why.
              </p>
              <p class="leading-relaxed text-stone-600 dark:text-stone-300">
                A HOLD is not a failure state. It usually says something true about the account or about the list it came from. Most tools in this category are built to always produce a message - which is exactly how outbound stops being worth reading.
              </p>
              <p class="text-sm text-stone-500 dark:text-stone-400">
                HOLD is a quality gate, not a correctness guarantee. It reduces the chance of sending something unsupported. It cannot tell you a message is right.
              </p>
            </div>
          </div>
        </Reveal>

        <!-- Refusals -->
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            refusals.map((r, i) => (
              <Reveal delay={i * 60} from="up">
                <div class="flex h-full flex-col gap-2 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                  <h3 class="flex items-start gap-2 text-base font-bold">
                    <Icon name="heroicons:x-circle" class="mt-0.5 h-5 w-5 shrink-0 text-stone-400" aria-hidden="true" />
                    {r.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{r.text}</p>
                </div>
              </Reveal>
            ))
          }
        </div>

        <Reveal class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={architectureUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>How it works, in detail</span>
            <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
          </a>
        </Reveal>
      </section>
    </div>
  </div>

  <!-- What the engine runs on. One marquee, kept because it substantiates the wedge. -->
  <References marks={engineTools} label="What the research engine runs on" />

  <!-- ════ 4. Where this actually is ════ -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-status-heading">
      <Reveal class="mb-10 flex flex-col items-center gap-3 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Where this actually is</span>
        <h2 id="home-status-heading" class="text-3xl font-bold sm:text-4xl">Built today, and being extended.</h2>
        <p class="max-w-2xl text-stone-600 dark:text-stone-300">
          Stated plainly, because you will ask on the first call anyway.
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <Reveal from="left">
          <div class="flex h-full flex-col gap-3 rounded-xl border-2 border-green-600/40 bg-white p-6 sm:p-8 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:check-circle" class="h-6 w-6 shrink-0 text-green-600 dark:text-green-400" aria-hidden="true" />
              Running
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">The research and account-analysis layer, deployed and reachable as an API</li>
              <li class="m-0">Evidence captured with the source behind each observation</li>
              <li class="m-0"><a href="https://www.npmjs.com/package/intel-echo" target="_blank" rel="noopener">intel-echo</a>, published on npm - auditing where an AI's reasoning exceeded its mandate</li>
            </ul>
          </div>
        </Reveal>
        <Reveal from="right">
          <div class="flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 sm:p-8 dark:border-stone-700 dark:bg-stone-900">
            <h3 class="flex items-center gap-2 text-lg font-bold">
              <Icon name="heroicons:beaker" class="h-6 w-6 shrink-0 text-stone-400" aria-hidden="true" />
              In private testing
            </h3>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              <li class="m-0">The outbound reasoning layer - hypothesis, message angle, the judge and HOLD</li>
              <li class="m-0">Built and running locally, tested against a small number of real accounts</li>
              <li class="m-0">Not yet deployed alongside the research layer, and not sold as a finished product</li>
            </ul>
            <p class="mt-auto pt-2 text-sm text-stone-500 dark:text-stone-400">
              If you want to see it, the honest version is a live run on one of your accounts rather than a demo.
            </p>
          </div>
        </Reveal>
      </div>
    </section>
  </div>

  <!-- ════ 5. Proof ════ -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section aria-labelledby="home-proof-heading">
        <Reveal class="mb-10 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Proof</span>
          <h2 id="home-proof-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">Go and read the work, rather than taking my word for it.</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            There are no client logos here, and no case studies. There are no external client engagements yet, so anything in that shape would be invented. What exists instead is work you can open.
          </p>
        </Reveal>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
          <Reveal from="up">
            <a href="https://www.npmjs.com/package/intel-echo" target="_blank" rel="noopener" class="hover:border-primary dark:hover:border-primary-light unstyle-link flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 transition-all hover:shadow-lg dark:border-stone-700 dark:bg-stone-900">
              <span class="text-primary dark:text-primary-light font-mono text-xs font-semibold tracking-widest uppercase">Published package</span>
              <h3 class="flex items-center gap-2 text-lg font-bold">
                <Icon name="simple-icons:npm" class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                intel-echo
              </h3>
              <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                An npm package that audits where an AI's reasoning exceeded its mandate. It came out of running these systems in production. Install it and read the source.
              </p>
            </a>
          </Reveal>
          <Reveal delay={60} from="up">
            <a href={architectureUrl} class="hover:border-primary dark:hover:border-primary-light unstyle-link flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 transition-all hover:shadow-lg dark:border-stone-700 dark:bg-stone-900">
              <span class="text-primary dark:text-primary-light font-mono text-xs font-semibold tracking-widest uppercase">The system itself</span>
              <h3 class="flex items-center gap-2 text-lg font-bold">
                <Icon name="heroicons:cpu-chip" class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                How the engine works
              </h3>
              <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                The full delivery architecture, written out: research, evidence, reasoning, the judge, and the point where the pipeline stops itself.
              </p>
            </a>
          </Reveal>
          <Reveal delay={120} from="up">
            <a href={blogUrl} class="hover:border-primary dark:hover:border-primary-light unstyle-link flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 transition-all hover:shadow-lg dark:border-stone-700 dark:bg-stone-900">
              <span class="text-primary dark:text-primary-light font-mono text-xs font-semibold tracking-widest uppercase">Written method</span>
              <h3 class="flex items-center gap-2 text-lg font-bold">
                <Icon name="heroicons:document-text" class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                How to audit your GTM motion
              </h3>
              <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
                The audit I run before writing a line of automation, written out so you can run it yourself without hiring anyone.
              </p>
            </a>
          </Reveal>
        </div>
      </section>
    </div>
  </div>

  <!-- ════ 6. The thesis ════ -->
  <div class="container mx-auto py-20">
    <section aria-labelledby="home-thesis-heading">
      <Reveal class="mx-auto mb-10 flex max-w-3xl flex-col items-center gap-4 text-center">
        <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">The thesis</span>
        <h2 id="home-thesis-heading" class="text-3xl font-bold text-balance sm:text-4xl">Building got cheap. Getting bought did not.</h2>
        <p class="text-lg leading-relaxed text-stone-600 dark:text-stone-300">
          The cost of building a product has collapsed. The cost of finding someone who wants it has not moved. That gap is where most startups now die, and it is a distribution problem being solved with more building.
        </p>
        <p class="leading-relaxed text-stone-600 dark:text-stone-300">
          It runs the length of the funnel - market, message, motion, pipeline, retention - and a break early on is invisible until it shows up as a revenue problem much later. Which is why the work starts at the decision rather than at the send.
        </p>
      </Reveal>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          motions.map((m, i) => (
            <Reveal delay={i * 70} from="up">
              <div class="flex h-full flex-col gap-3 rounded-xl border border-stone-300 bg-white p-6 dark:border-stone-700 dark:bg-stone-900">
                <span class="text-primary dark:text-primary-light font-mono text-2xl font-bold tabular-nums">{m.stage}</span>
                <h3 class="text-base font-bold">{m.title}</h3>
                <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">{m.text}</p>
              </div>
            </Reveal>
          ))
        }
      </div>

      <Reveal class="mt-8 flex justify-center">
        <p class="max-w-2xl text-center text-sm text-stone-500 dark:text-stone-400">
          Startups and services businesses, in all three. The stage changes what breaks; it does not change where you start looking.
        </p>
      </Reveal>
    </section>
  </div>

  <!-- ════ 7. Method and engagement ════ -->
  <div class="graph-paper-bg-inner">
    <div class="container mx-auto py-20">
      <section id="gtm-audit" aria-labelledby="home-method-heading" class="scroll-mt-28">
        <Reveal class="mb-12 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">How the work runs</span>
          <h2 id="home-method-heading" class="max-w-3xl text-3xl font-bold text-balance sm:text-4xl">The same sequence every time, whatever the motion.</h2>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Nothing gets built before the diagnosis, and nothing widens before it has been measured against a baseline.
          </p>
        </Reveal>

        <!-- ── The one process diagram on this page ── -->
        <Reveal>
          <ol class="method-chain m-0 grid list-none grid-cols-1 gap-0 p-0 sm:grid-cols-2 lg:grid-cols-6" aria-label="Delivery method">
            {
              method.map((step, i) => (
                <li class="method-step relative m-0 flex flex-col gap-2 border border-stone-300 bg-white p-5 first:rounded-t-xl last:rounded-b-xl sm:first:rounded-tr-none sm:last:rounded-bl-none lg:first:rounded-l-xl lg:first:rounded-tr-none lg:last:rounded-r-xl lg:last:rounded-bl-none dark:border-stone-700 dark:bg-stone-900">
                  <div class="flex items-center gap-2">
                    <Icon name={step.icon} class="text-primary dark:text-primary-light h-5 w-5 shrink-0" aria-hidden="true" />
                    <span class="font-mono text-xs text-stone-400 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                  </div>
                  <span class="text-base font-bold">{step.label}</span>
                  <p class="m-0 text-xs leading-relaxed text-stone-600 dark:text-stone-300">{step.text}</p>
                </li>
              ))
            }
          </ol>
        </Reveal>

        <!-- ── The commercial ladder, as a list ── -->
        <Reveal class="mt-16 mb-8 flex flex-col items-center gap-3 text-center">
          <span class="text-primary dark:text-primary-light text-sm font-semibold tracking-[0.2em] uppercase">Where an engagement starts</span>
          <h3 class="text-2xl font-bold sm:text-3xl">Start small, on purpose.</h3>
          <p class="max-w-2xl text-stone-600 dark:text-stone-300">
            Each step is worth doing on its own, and each one decides whether the next is worth doing at all.
          </p>
        </Reveal>

        <ol class="m-0 flex list-none flex-col gap-5 p-0">
          {
            ladder.map((rung, i) => (
              <Reveal as="li" delay={i * 70} from="up" class="m-0">
                <article
                  class:list={[
                    'flex h-full flex-col gap-5 rounded-xl bg-white p-6 transition-all hover:shadow-lg sm:flex-row sm:gap-8 sm:p-8 dark:bg-stone-900',
                    i === 0 ? 'border-primary border-2' : 'border border-stone-300 dark:border-stone-700',
                  ]}
                >
                  <div class="flex shrink-0 items-center gap-4 sm:w-52 sm:flex-col sm:items-start sm:gap-2">
                    <span class="text-primary dark:text-primary-light font-mono text-3xl font-bold tabular-nums">{rung.n}</span>
                    <div class="flex flex-col gap-1">
                      <span class="text-lg font-bold">{rung.name}</span>
                      <span class="text-primary dark:text-primary-light text-xl font-bold">{rung.price}</span>
                      <span class="font-mono text-xs tracking-wide text-stone-500 uppercase dark:text-stone-400">{rung.note}</span>
                    </div>
                  </div>
                  <div class="flex flex-col gap-3">
                    <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{rung.text}</p>
                    <p class="m-0 border-t border-stone-200 pt-3 text-sm leading-relaxed text-stone-500 dark:border-stone-700 dark:text-stone-400">{rung.limit}</p>
                  </div>
                </article>
              </Reveal>
            ))
          }
        </ol>

        <Reveal class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={pricingUrl} class="btn-subtle group rounded px-4 py-[0.43rem]">
            <span>Compare the two build models</span>
