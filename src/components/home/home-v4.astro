---
import { Icon } from "astro-icon/components";
import { getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";

interface Props {
  locale?: string;
}

const { locale = themeConfig.i18n.defaultLocale } = Astro.props;

/*
  Homepage v4.

  The brief: the argument was right but drowned in prose. Every idea here is
  carried by an artifact - the broken motion, the diagnostic, the HOLD card -
  and the copy exists only to label them. If a paragraph can be deleted without
  losing the argument, it has been.

  Design tokens are scoped to .v4 rather than changed globally, so the rest of
  the site keeps the existing identity while this is reviewed.
*/

const intro = "https://calendly.com/praveenshahi13/30min";
const architecture = getLocaleUrl("architecture", locale);

// Step 01 - the diagnostic artifact
const readiness = [
  { area: "ICP", pct: 72, flag: false },
  { area: "Data & signals", pct: 41, flag: true },
  { area: "Message", pct: 81, flag: false },
  { area: "Qualification", pct: 37, flag: true },
  { area: "Follow-up", pct: 54, flag: false },
  { area: "Process", pct: 62, flag: false },
];

// Step 02 - the system
const system = [
  { label: "Data & signals", icon: "heroicons:circle-stack", text: "Relevant accounts and real buying indicators" },
  { label: "AI research", icon: "heroicons:cpu-chip", text: "Deep account research and commercial hypotheses" },
  { label: "Qualification", icon: "heroicons:clipboard-document-check", text: "Evidence-based fit and buying-intent evaluation" },
  { label: "Engagement", icon: "heroicons:paper-airplane", text: "Personalised outreach only when evidence supports it" },
];

// Step 03 - the HOLD card
const accountChecks = [
  { label: "ICP fit", ok: true },
  { label: "Company growth", ok: true },
  { label: "Decision maker identified", ok: true },
  { label: "Recent funding / change", ok: true },
  { label: "Buying evidence", ok: false },
];

const credentials = ["10+ years of experience", "6+ brands scaled", "Millions in pipeline generated"];

const outcomes = [
  { icon: "heroicons:arrow-trending-up", text: "Higher quality pipeline" },
  { icon: "heroicons:user-group", text: "More qualified meetings" },
  { icon: "heroicons:clock", text: "Shorter sales cycles" },
  { icon: "heroicons:light-bulb", text: "Better GTM decision making" },
];

const impact = [
  { figure: "2–3x", label: "increase in qualified meetings" },
  { figure: "30–40%", label: "improvement in SQL conversion" },
  { figure: "20–50%", label: "reduction in sales cycle time" },
];

const fit = [
  "You're a founder or GTM leader",
  "You sell high-value B2B",
  "Quality over volume",
  "You have conflicting internal diagnoses",
  "Research is your constraint",
];

const notFit = [
  "You want volume, regardless of evidence",
  "You want fully autonomous outreach",
  "You need a tool or a sequencer",
  "You want someone else to make every decision",
  "You're not ready to change how you do GTM",
];

/*
  Logos exist in simple-icons for only some of these. Rather than a half-broken
  grid, every tool gets an identically sized tile: a real mark where one is
  available, a wordmark where it is not.
*/
const stack = [
  { group: "Data & intel", tools: [{ n: "Clay" }, { n: "ZoomInfo" }, { n: "Apollo" }, { n: "Clearbit" }] },
  { group: "Signals", tools: [{ n: "Common Room" }, { n: "Warmly" }, { n: "G2", i: "simple-icons:g2" }, { n: "RB2B" }] },
  { group: "CRM", tools: [{ n: "HubSpot", i: "simple-icons:hubspot" }, { n: "Salesforce", i: "simple-icons:salesforce" }, { n: "Attio" }] },
  { group: "Orchestration", tools: [{ n: "n8n", i: "simple-icons:n8n" }, { n: "LangGraph", i: "simple-icons:langgraph" }, { n: "PostgreSQL", i: "simple-icons:postgresql" }] },
];

const engage = [
  { n: "1", title: "Intro conversation", text: "30 minutes to understand your GTM motion and challenges." },
  { n: "2", title: "GTM diagnostic", text: "A deep audit that identifies the real constraint on pipeline." },
  { n: "3", title: "Pilot", text: "We build, test and prove the system on a focused segment." },
  { n: "4", title: "Ongoing systems", text: "Scale what works and keep improving outcomes." },
];
---

<div class="v4">
  <!-- ════════════ HERO ════════════ -->
  <section class="v4-ink relative overflow-hidden">
    <div class="container mx-auto grid grid-cols-1 items-center gap-14 px-6 py-24 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16 lg:py-32">
      <div>
        <h1 class="v4-display text-[clamp(2.6rem,5.2vw,4.1rem)] leading-[1.06]">
          You're probably<br />solving the <span class="v4-accent">wrong problem.</span>
        </h1>
        <p class="v4-lede mt-7 max-w-md">
          We run evidence-led GTM diagnostics that find the real bottleneck — before you build, buy, or scale.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-6">
          <a href={intro} target="_blank" rel="noopener" class="v4-btn-ghost">Book a GTM diagnostic</a>
          <a href={architecture} class="v4-play group">
            <span class="v4-play-dot"><Icon name="heroicons:arrow-right" class="h-3 w-3" aria-hidden="true" /></span>
            <span>See the architecture</span>
          </a>
        </div>
      </div>

      <!--
        The broken motion, as SVG so the bracket, the branch off DATA and the
        question all line up exactly. HTML boxes could not hold the alignment.
      -->
      <figure class="m-0">
        <svg class="v4-svg" viewBox="0 0 680 300" role="img" aria-labelledby="motion-title">
          <title id="motion-title">A go-to-market motion running ICP to data to message to outbound to sales pipeline, with an unknown break in the middle</title>

          <!-- span bracket -->
          <text x="340" y="16" class="s-kicker" text-anchor="middle">YOUR GTM MOTION</text>
          <path d="M14 42 V30 H666 V42" class="s-bracket" />

          <!-- the motion -->
          <g class="s-node"><rect x="14" y="62" width="74" height="46" /><text x="51" y="90" text-anchor="middle">ICP</text></g>
          <text x="103" y="90" class="s-arrow" text-anchor="middle">→</text>
          <g class="s-node"><rect x="118" y="62" width="86" height="46" /><text x="161" y="90" text-anchor="middle">DATA</text></g>
          <text x="219" y="90" class="s-arrow" text-anchor="middle">→</text>
          <g class="s-node"><rect x="234" y="62" width="122" height="46" /><text x="295" y="90" text-anchor="middle">MESSAGE</text></g>
          <text x="371" y="90" class="s-arrow" text-anchor="middle">→</text>
          <g class="s-node"><rect x="386" y="62" width="132" height="46" /><text x="452" y="90" text-anchor="middle">OUTBOUND</text></g>
          <text x="533" y="90" class="s-arrow" text-anchor="middle">→</text>
          <g class="s-node is-end"><rect x="548" y="62" width="118" height="46" /><text x="607" y="84" text-anchor="middle">SALES</text><text x="607" y="100" text-anchor="middle">PIPELINE</text></g>

          <!-- the break: branches off DATA, which is where the diagnostic found it -->
          <path d="M161 108 V150" class="s-drop" />
          <rect x="96" y="150" width="130" height="46" class="s-unknown" />
          <text x="161" y="180" class="s-q" text-anchor="middle">?   ?   ?</text>
          <path d="M161 196 V232" class="s-drop" />
          <path d="M155 224 L161 233 L167 224" class="s-tip" />
          <text x="161" y="256" class="s-ask" text-anchor="middle">WHERE IS IT</text>
          <text x="161" y="276" class="s-ask" text-anchor="middle">ACTUALLY BREAKING?</text>
        </svg>
      </figure>
    </div>
  </section>

  <!-- ════════════ STEP 01 ════════════ -->
  <section class="v4-paper">
    <div class="container mx-auto grid grid-cols-1 gap-12 px-6 py-24 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-16">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <span class="v4-step">Step 01</span>
        <h2 class="v4-h2 mt-4">We start with a GTM Audit, not assumptions.</h2>
        <p class="v4-body mt-5">We map your motion, evaluate the evidence, and identify the real constraint on pipeline.</p>
      </div>

      <!-- The deliverable, made concrete. -->
      <figure class="v4-doc m-0">
        <header class="v4-doc-head">
          <span class="v4-doc-title">Amoris / GTM Diagnostic</span>
          <span class="v4-doc-pin" aria-hidden="true"></span>
        </header>
        <div class="v4-doc-body">
          <div>
            <span class="v4-kicker">Readiness</span>
            <ul class="m-0 mt-4 flex list-none flex-col gap-3 p-0">
              {
                readiness.map((r) => (
                  <li class="m-0 grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1">
                    <span class="v4-doc-label">{r.area}</span>
                    <span class:list={["v4-doc-pct", r.flag && "is-flag"]}>{r.pct}%</span>
                    <span class="v4-bar col-span-2"><span class:list={["v4-bar-fill", r.flag && "is-flag"]} style={`--w:${r.pct}%`} /></span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="v4-doc-finding">
            <span class="v4-kicker">Finding</span>
            <p class="v4-doc-p mt-3">The bottleneck isn't lead volume. It's <strong>qualification and signal quality</strong>.</p>
            <span class="v4-kicker mt-6 block">Recommendation</span>
            <p class="v4-doc-p mt-3">Fix qualification and enrich buying signals before scaling outbound.</p>
            <span class="v4-note">Primary<br />constraint</span>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- ════════════ STEP 02 ════════════ -->
  <section id="how-it-works" class="v4-ink scroll-mt-24">
    <div class="container mx-auto grid grid-cols-1 gap-12 px-6 py-24 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-16">
      <div>
        <span class="v4-step">Step 02</span>
        <h2 class="v4-h2 mt-4">Then we design and build the right GTM system.</h2>
        <p class="v4-body mt-5">Diagnosis turns into a system that finds the right accounts, at the right time, with the right message.</p>
      </div>

      <figure class="m-0">
        <div class="v4-sys">
          {
            system.map((n, i) => (
              <>
                <div class="v4-sys-node">
                  <Icon name={n.icon} class="v4-sys-icon" aria-hidden="true" />
                  <span class="v4-sys-label">{n.label}</span>
                  <span class="v4-sys-text">{n.text}</span>
                </div>
                <span class="v4-sys-arrow" aria-hidden="true">→</span>
              </>
            ))
          }
          <div class="v4-sys-node is-goal">
            <Icon name="heroicons:user-group" class="v4-sys-icon" aria-hidden="true" />
            <span class="v4-sys-label">Qualified meetings</span>
          </div>
        </div>
        <figcaption class="v4-accent mt-7 text-center font-medium italic">Evidence first. Outreach second.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ════════════ STEP 03 ════════════ -->
  <section class="v4-paper">
    <div class="container mx-auto grid grid-cols-1 gap-12 px-6 py-24 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-16">
      <div>
        <span class="v4-step">Step 03</span>
        <h2 class="v4-h2 mt-4">The best GTM system sometimes does nothing.</h2>
        <p class="v4-body mt-5">The HOLD principle means your team spends time only where there's real evidence of a buying motion.</p>
      </div>

      <div class="flex flex-col gap-8">
        <figure class="v4-hold m-0">
          <div class="v4-hold-col">
            <span class="v4-kicker">Account review</span>
            <span class="v4-hold-co">Acme Corp</span>
            <ul class="m-0 mt-4 flex list-none flex-col gap-2.5 p-0">
              {
                accountChecks.map((c) => (
                  <li class:list={["v4-hold-check m-0", !c.ok && "is-miss"]}>
                    <Icon name={c.ok ? "heroicons:check" : "heroicons:x-mark"} class="h-4 w-4 shrink-0" aria-hidden="true" />
                    {c.label}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="v4-hold-col is-mid">
            <span class="v4-kicker">Evidence</span>
            <p class="v4-doc-p mt-3">No recent trigger events in the past 90 days.</p>
            <p class="v4-doc-p mt-3">No relevant intent or project signals detected.</p>
          </div>
          <div class="v4-hold-col is-decision">
            <span class="v4-kicker">Decision</span>
            <span class="v4-hold-verdict">HOLD</span>
            <p class="v4-doc-p">Not enough evidence to spend a sales touch.</p>
          </div>
        </figure>
        <blockquote class="v4-quote m-0">
          Most systems are built to send more.<br />Ours is built to decide better.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ════════════ FOUNDER ════════════ -->
  <section class="v4-ink">
    <div class="container mx-auto px-6 py-20">
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-[1.2fr_0.85fr_1.05fr] lg:gap-14">
        <div class="flex items-start gap-6">
          <img src="/founder.png" alt="Praveen Shahi, founder of Amoris" width="160" height="160" loading="lazy" decoding="async" class="v4-portrait" />
          <div class="min-w-0">
            <span class="v4-kicker">Founder-led</span>
            <p class="v4-name mt-2">Praveen Shahi</p>
            <p class="v4-role mt-1">Ex-Amazon, Ex-Meta</p>
            <ul class="m-0 mt-4 flex list-none flex-col gap-1.5 p-0">
              {credentials.map((c) => <li class="v4-cred m-0">{c}</li>)}
            </ul>
          </div>
        </div>

        <div>
          <span class="v4-kicker">Outcomes we drive</span>
          <ul class="m-0 mt-4 flex list-none flex-col gap-3 p-0">
            {
              outcomes.map((o) => (
                <li class="v4-outcome m-0">
                  <Icon name={o.icon} class="v4-accent h-5 w-5 shrink-0" aria-hidden="true" />
                  {o.text}
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <span class="v4-kicker">Client impact</span>
          <div class="v4-impact mt-4">
            {
              impact.map((m) => (
                <div class="v4-impact-cell">
                  <span class="v4-figure">{m.figure}</span>
                  <span class="v4-figure-label">{m.label}</span>
                </div>
              ))
            }
          </div>
          <p class="v4-fine v4-fine-sep">From prior client engagements. Results vary with industry, ICP and current GTM maturity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ FIT + STACK ════════════ -->
  <section class="v4-paper">
    <div class="container mx-auto grid grid-cols-1 gap-12 px-6 py-20 lg:grid-cols-[1fr_1fr_1.2fr] lg:gap-14">
      <div>
        <span class="v4-kicker">We're a great fit if</span>
        <ul class="m-0 mt-4 flex list-none flex-col gap-2.5 p-0">
          {
            fit.map((f) => (
              <li class="v4-fit m-0">
                <Icon name="heroicons:check-circle" class="h-4.5 w-4.5 shrink-0 text-emerald-700" aria-hidden="true" />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <span class="v4-kicker">We're not a fit if</span>
        <ul class="m-0 mt-4 flex list-none flex-col gap-2.5 p-0">
          {
            notFit.map((f) => (
              <li class="v4-fit m-0">
                <Icon name="heroicons:x-circle" class="h-4.5 w-4.5 shrink-0 text-red-700/70" aria-hidden="true" />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <span class="v4-kicker">The stack we work across</span>
        <div class="mt-4 flex flex-col gap-5">
          {
            stack.map((s2) => (
              <div>
                <span class="v4-stack-group">{s2.group}</span>
                <ul class="v4-tiles m-0 mt-2 list-none p-0">
                  {
                    s2.tools.map((t) => (
                      <li class="v4-tile m-0">
                        {t.i ? <Icon name={t.i} class="v4-tile-logo" aria-hidden="true" /> : null}
                        <span class="v4-tile-name">{t.n}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          }
        </div>
        <p class="v4-fine mt-4">Built with and integrated into — not a list of pre-built connectors.</p>
      </div>
    </div>
  </section>

  <!-- ════════════ ENGAGEMENT ════════════ -->
  <section class="v4-ink">
    <div class="container mx-auto grid grid-cols-1 gap-12 px-6 py-20 lg:grid-cols-[minmax(0,0.5fr)_minmax(0,1.5fr)] lg:gap-16">
      <div>
        <span class="v4-kicker">How we engage</span>
        <h2 class="v4-h2 mt-4 text-[1.7rem]">A focused path from clarity to compounding results.</h2>
      </div>
      <ol class="v4-engage m-0 list-none p-0">
        {
          engage.map((e) => (
            <li class="v4-engage-step m-0">
              <span class="v4-engage-n">{e.n}</span>
              <span class="v4-engage-title">{e.title}</span>
              <span class="v4-engage-text">{e.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ════════════ LEARN ════════════ -->
  <section class="v4-ink" aria-labelledby="home-learn">
    <div class="container mx-auto px-6 pb-16">
      <div class="v4-learn">
        <div class="flex flex-col gap-3">
          <span class="v4-kicker">Amoris Learn</span>
          <h2 id="home-learn" class="v4-h2">Learn to build this yourself.</h2>
          <p class="v4-body max-w-2xl">
            Amoris builds AI GTM systems for companies. Amoris Learn teaches professionals to build their own &mdash; from AI literacy to designing AI-powered workflows and systems.
          </p>
          <p class="v4-fine italic">Same principle: audit before you automate.</p>
        </div>
        <a href="/learn-ai" class="v4-btn-ghost shrink-0">Find your AI level &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ════════════ CLOSE ════════════ -->
  <section class="v4-paper">
    <div class="container mx-auto flex flex-col items-center gap-7 px-6 py-20 text-center">
      <h2 class="v4-display text-[clamp(2rem,3.6vw,2.9rem)] leading-tight">Let's find the bott<span class="v4-accent">leneck.</span></h2>
      <p class="v4-body max-w-md">30 minutes can save you months of guessing.</p>
      <div class="mt-1 flex flex-wrap items-center justify-center gap-6">
        <a href={intro} target="_blank" rel="noopener" class="v4-btn">Book a GTM diagnostic</a>
        <span class="v4-play">
          <span class="v4-play-dot"><Icon name="heroicons:check" class="h-3 w-3" aria-hidden="true" /></span>
          <span>No deck. No spam. Just clarity.</span>
        </span>
      </div>
    </div>
  </section>
</div>

<style>
  @reference "../../styles/tailwind.config.css";



  /* ── Header over the dark hero ──────────────────────────────────────
     The header picks its logo from the visitor's colour theme, not from what
     is actually behind it. On this page the hero is near-black whatever the
     theme, so a light-mode visitor got the dark-navy wordmark on near-black
     and could not see it.

     `data-overlay-theme="dark"` is present only while the header overlays the
     hero - the scroll script removes it when the header turns solid - so
     keying off it fixes the overlay state and leaves the scrolled state alone.
     This stylesheet only ships on the homepage, so it cannot affect other pages. */
  :global(#header[data-overlay-theme='dark'] .header-logo-dark) {
    display: none;
  }
  :global(#header[data-overlay-theme='dark'] .header-logo-white) {
    display: block;
  }
  /* Nav and icons sit on the hero, so hold them at full strength there. */
  :global(#header[data-overlay-theme='dark']) {
    color: #f5f3ee;
  }
  :global(#header[data-overlay-theme='dark'] nav[aria-label='Main'] a) {
    color: #f5f3ee;
  }
  :global(#header[data-overlay-theme='dark'] nav[aria-label='Main'] a:hover) {
    color: #ffffff;
  }

  /* ── Scoped identity ───────────────────────────────────────────────
     Kept on .v4 rather than the global tokens so every other page keeps
     the current look while this version is reviewed. */
    .v4 {
    --ink: #0e1116;
    --ink-2: #151a22;
    --paper: #f4f0e6;
    --paper-2: #fbf8f1;
    --gold: #c9a227;
    --gold-soft: #e3c766;
    --on-ink: #e8e4da;
    --on-ink-dim: #9aa1ab;
    --on-paper: #1a1d23;
    --on-paper-dim: #5c6068;
    --rule-ink: rgb(255 255 255 / 0.12);
    --rule-paper: rgb(0 0 0 / 0.12);
  }

  .v4-ink {
    background: var(--ink);
    color: var(--on-ink);
  }
  .v4-paper {
    background: var(--paper);
    color: var(--on-paper);
  }

  /* ── Type scale. One scale, used everywhere. ── */
  .v4-display {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-weight: 600;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 90;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .v4-h2 {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-weight: 600;
    font-variation-settings: 'opsz' 40;
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .v4-lede {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--on-ink-dim);
    margin: 0;
  }
  .v4-body {
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--on-paper-dim);
    margin: 0;
  }
  .v4-ink .v4-body {
    color: var(--on-ink-dim);
  }
  .v4-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .v4-step {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .v4-accent {
    color: var(--gold);
  }
  .v4-dim {
    color: var(--on-ink-dim);
  }
  .v4-fine {
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--on-ink-dim);
    margin: 0;
  }
  .v4-paper .v4-fine {
