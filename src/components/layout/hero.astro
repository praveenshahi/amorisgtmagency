---
import { Icon } from "astro-icon/components";
import References from "@components/layout/references.astro";
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);

function generateStars(count: number, spread = 3000): string {
  return Array.from({ length: count }, () => {
    const x = Math.floor(Math.random() * spread);
    const y = Math.floor(Math.random() * spread);
    const opacity = (0.4 + Math.random() * 0.6).toFixed(2);
    return `${x}px ${y}px rgba(255,255,255,${opacity})`;
  }).join(",");
}

const stars1 = generateStars(160); // 1 px - many
const stars2 = generateStars(60);  // 2 px - medium
const stars3 = generateStars(22);  // 3 px - few bright

// The stack is named explicitly because these are the terms buyers and answer
// engines actually search for.
const stack = ["LangGraph", "Clay", "n8n", "PostgreSQL", "Retell / ElevenLabs"];
---

<div role="banner" class="hero relative flex min-h-svh w-full flex-col items-center justify-center overflow-hidden px-6 pt-40 pb-20" style={`--stars1:${stars1};--stars2:${stars2};--stars3:${stars3};`}>
  <!-- Animated galaxy background -->
  <div class="galaxy-bg pointer-events-none">
    <div class="nebula"></div>
    <div class="s1 absolute inset-0"></div>
    <div class="s2 absolute inset-0"></div>
    <div class="s3 absolute inset-0"></div>
  </div>

  <!-- Hero content -->
  <div class="relative z-10 flex w-full max-w-4xl flex-col items-center gap-6 text-center">
    <a href={getLocaleUrl('products#amoris-ai-sdr', locale)} class="group inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-sm text-white/70 no-underline backdrop-blur transition-colors hover:border-white/40 hover:text-white">
      <span class="bg-primary h-1.5 w-1.5 shrink-0 rounded-full"></span>
      <span>{t('pages.home.hero-chip')}</span>
      <Icon name="heroicons:arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
    </a>

    <h1 class="hero-title">{t('pages.home.hero-title')}</h1>
    <p class="hero-subline">{t('pages.home.hero-sub-slogan')}</p>

    <div class="mt-1 flex flex-wrap justify-center gap-4">
      <a href="https://calendly.com/praveenshahi13/30min" target="_blank" rel="noopener" class="btn-primary">{t('labels.book-audit')}</a>
      <a href={getLocaleUrl('products', locale)} class="group inline-flex cursor-pointer items-center gap-2 rounded border-2 border-white/30 bg-white/5 px-4 py-2 pr-3 text-base font-semibold whitespace-nowrap text-white/80 no-underline transition-all select-none hover:border-white hover:text-white">
        <span>{t('labels.see-the-work')}</span>
        <Icon name="heroicons:arrow-right" class="mr-1 ml-0 h-4 w-4 transition-all duration-200 group-hover:mr-0 group-hover:ml-1" aria-hidden="true" />
      </a>
    </div>

    <ul class="mt-6 flex list-none flex-wrap justify-center gap-2 p-0" aria-label="Core technologies">
      {
        stack.map((item) => (
          <li class="m-0 rounded-full border border-white/15 px-3 py-1 font-mono text-xs tracking-wide text-white/60">{item}</li>
        ))
      }
    </ul>
  </div>
</div>

<References {locale} />

<style>
  @reference "../../styles/tailwind.config.css";

  /* ── Wrapper - only the gradient survives here ── */
  .hero {
    background: radial-gradient(ellipse at 50% 40%, #1b0b4d 0%, #060318 55%, #000 100%);
  }

  /* ── Rotating galaxy container ── */
  .galaxy-bg {
    @apply absolute top-1/2 left-1/2 h-[3000px] w-[3000px] origin-center;
    animation: galaxyRotate 150s linear infinite;
  }

  @keyframes galaxyRotate {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  /* ── Nebula blobs ── */
  .nebula {
    @apply absolute inset-0;
    background: radial-gradient(ellipse 55% 38% at 28% 38%, rgba(139, 44, 255, 0.55) 0%, transparent 65%), radial-gradient(ellipse 38% 28% at 72% 62%, rgba(0, 217, 255, 0.22) 0%, transparent 65%), radial-gradient(ellipse 48% 52% at 62% 22%, rgba(67, 97, 255, 0.42) 0%, transparent 60%), radial-gradient(ellipse 65% 42% at 42% 82%, rgba(8, 6, 40, 0.85) 0%, transparent 70%);
    animation: nebulaPulse 24s ease-in-out infinite alternate;
  }

  @keyframes nebulaPulse {
    0% {
      opacity: 0.72;
    }
    100% {
      opacity: 1;
    }
  }

  /* ── Star layers ── */
  .s1::before {
    content: '';
    @apply absolute top-0 left-0 size-px rounded-full bg-transparent;
    box-shadow: var(--stars1);
    animation: twinkle 10s ease-in-out infinite alternate;
  }

  .s2::before {
    content: '';
    @apply absolute top-0 left-0 size-[2px] rounded-full bg-transparent;
    box-shadow: var(--stars2);
    animation: twinkle 14s ease-in-out infinite alternate;
  }

  .s3::before {
    content: '';
    @apply absolute top-0 left-0 size-[3px] rounded-full bg-transparent;
    box-shadow: var(--stars3);
    animation: twinkle 18s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    0% {
      opacity: 0.6;
    }
    100% {
      opacity: 1;
    }
  }

  /* Title */
  .hero-title {
    @apply m-0 leading-[1.08] font-bold tracking-[-0.025em] text-white;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    text-shadow: 0 0 80px rgba(67, 97, 255, 0.35);
  }

  /* Subline */
  .hero-subline {
    @apply m-0 max-w-[40rem] leading-[1.65] text-white/55;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .galaxy-bg,
    .nebula,
    .s1::before,
    .s2::before,
    .s3::before {
      animation: none;
    }
  }
</style>
