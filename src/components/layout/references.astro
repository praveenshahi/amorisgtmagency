---
import { Icon } from "astro-icon/components";

export interface Mark {
  /** simple-icons name, e.g. "simple-icons:openai". Omit for a typographic wordmark. */
  name?: string;
  label: string;
}

interface Props {
  marks: Mark[];
  /** Sits above the track. Long enough sentences are fine here - it is not a narrow rail. */
  label: string;
  /** Scrolls right-to-left instead, so two marquees on one page do not look mechanical. */
  reverse?: boolean;
  class?: string;
}

const { marks, label, reverse = false, class: className = '' } = Astro.props as Props;

/*
  Brand marks come from @iconify-json/simple-icons, which is a local dependency -
  they are inlined at build time, so there is no CDN request that can fail. Anything
  without an official mark in that set (Clay, Great Learning, Leverage Edu) is set as
  a wordmark at the same optical weight, which keeps the row consistent.

  Pure CSS marquee: the set is rendered twice and the track is translated by exactly
  -50%, so the second copy lands where the first began. Nothing to initialise, and the
  names stay in the HTML for crawlers and for anyone with scripts off.

  Duration scales with the item count (~8s per item, matching the original 32s for four)
  so a long row and a short row move at the same perceived speed rather than the long
  one racing past.
*/
const duration = marks.length * 8;
---

<div class:list={['bg-stone-800 select-none', className]}>
  {/* No `m-0` here: it would zero the auto margins and pin the box left once the
      viewport passes max-w-2xl. `text-pretty` rather than `text-balance` - balance
      equalises line lengths, which chops a running sentence into four short lines on
      a phone. */}
  <p class="mx-auto max-w-2xl px-6 pt-9 pb-1 text-center text-sm font-semibold text-pretty text-white/90 sm:text-base">
    {label}
  </p>

  <div class="relative flex w-full items-center justify-center overflow-hidden pt-4 pb-10">
    <div class="marquee relative w-full overflow-hidden">
      <div class="marquee-track" style={`--marquee-duration:${duration}s;`} data-reverse={reverse ? 'true' : undefined}>
        {
          [0, 1].map((copy) => (
            <div class="marquee-set" aria-hidden={copy === 1 ? 'true' : undefined}>
              {marks.map((mark) => (
                <span class="flex shrink-0 items-center gap-2.5 text-2xl font-semibold tracking-tight whitespace-nowrap text-white/85">
                  {mark.name && <Icon name={mark.name} class="h-7 w-7 shrink-0" aria-hidden="true" />}
                  {mark.label}
                </span>
              ))}
            </div>
          ))
        }
      </div>
      <!-- Fades the marquee into the band edges instead of clipping mid-logo. -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-linear-to-r from-stone-800 to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-linear-to-l from-stone-800 to-transparent" aria-hidden="true"></div>
    </div>
  </div>

  <slot />
</div>

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll var(--marquee-duration, 32s) linear infinite;
  }

  .marquee-track[data-reverse] {
    animation-direction: reverse;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 5rem;
    padding: 0 2.5rem;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .marquee-set {
      gap: 3rem;
      padding: 0 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Without motion the second copy is redundant, so hide it and wrap the set instead. */
    .marquee-track {
      animation: none;
      width: 100%;
      justify-content: center;
    }
    .marquee-set[aria-hidden='true'] {
      display: none;
    }
    .marquee-set {
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
    }
  }
</style>
