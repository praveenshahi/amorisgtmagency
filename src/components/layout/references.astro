---
import { Icon } from "astro-icon/components";
import { useTranslations } from "@utils/i18n";

interface Props {
  locale: string;
  slogan?: boolean;
  hideSloganMobile?: boolean;
}

const { locale, slogan = true, hideSloganMobile = false } = Astro.props;
const t = useTranslations(locale);

/*
  These are the places Praveen ran revenue and built systems - employers, not clients.
  Amazon and Meta use their official brand marks, bundled locally via simple-icons, so
  there is no CDN left to break. Great Learning and Leverage Edu publish no open mark,
  so they are set as typographic wordmarks at the same optical weight.

  The marquee is pure CSS: the set is rendered twice in the markup and the track is
  translated by exactly -50%, so the second copy lands where the first began. No
  JavaScript means nothing to initialise, and the logos are still in the HTML for
  crawlers and for anyone with scripts disabled.
*/
const marks = [
  { type: "icon", name: "simple-icons:amazon", label: "Amazon" },
  { type: "icon", name: "simple-icons:meta", label: "Meta" },
  { type: "word", label: "Great Learning" },
  { type: "word", label: "Leverage Edu" },
];
---

<div class="bg-stone-800 select-none">
  {
    slogan && !hideSloganMobile && (
      <p class="mx-auto m-0 w-fit px-6 pt-8 pb-1 text-center text-sm font-semibold text-balance text-white md:hidden">{t('pages.home.references')}</p>
    )
  }

  <div class="relative flex w-full items-center justify-center overflow-hidden py-10">
    {
      slogan && (
        <div class="hidden shrink-0 items-center gap-3 pr-6 pl-10 text-left md:flex">
          <Icon name="heroicons:check-badge" class="h-9 w-9 shrink-0 text-green-400" aria-hidden="true" />
          <span class="max-w-32 text-xs font-semibold text-balance text-white lg:max-w-36 lg:text-sm">{t('pages.home.references')}</span>
        </div>
      )
    }
    <div class="marquee relative w-full overflow-hidden">
      <div class="marquee-track">
        {
          [0, 1].map((copy) => (
            <div class="marquee-set" aria-hidden={copy === 1 ? 'true' : undefined}>
              {marks.map((mark) => (
                <span class="flex shrink-0 items-center gap-2.5 text-2xl font-semibold tracking-tight whitespace-nowrap text-white/85">
                  {mark.name && <Icon name={mark.name} class="h-7 w-7 shrink-0" aria-hidden="true" />}
                  {mark.label}
                </span>
              ))}
            </div>
          ))
        }
      </div>
      <!-- Fades the marquee into the band edges instead of clipping mid-logo. -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-linear-to-r from-stone-800 to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-linear-to-l from-stone-800 to-transparent" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    /* Each item carries half the gap on both sides, so the seam between the two
       copies is spaced exactly like every other gap. */
    gap: 5rem;
    padding: 0 2.5rem;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .marquee-set {
      gap: 3rem;
      padding: 0 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    /* Without motion the second copy is redundant, so hide it and centre the set. */
    .marquee-track {
      justify-content: center;
      width: 100%;
    }
    .marquee-set[aria-hidden='true'] {
      display: none;
    }
    .marquee-set {
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
    }
  }
</style>
