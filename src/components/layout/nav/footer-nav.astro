---
import { useTranslations, getLocaleUrl } from "@utils/i18n";

interface Props {
  locale: string;
  isHome?: boolean;
}

const { locale, isHome } = Astro.props as Props;
const t = useTranslations(locale);

const linkClass = "unstyle-link group-hover:text-text-dark/60 hover:text-text-dark text-text-dark/80 w-fit pt-1.5";
---

<nav role="navigation" class="xs:grid-cols-2 text-text-dark xs:justify-items-start grid w-full grid-cols-1 justify-items-center gap-14 text-left text-sm sm:grid-cols-3 md:w-auto md:grid-cols-2 lg:grid-cols-3 xl:gap-20">
  <div class="xs:items-start group flex flex-col items-center">
    <h3>{t('labels.offering')}</h3>
    {!isHome ? <a class={linkClass} href={getLocaleUrl('/', locale)}>{t('nav.home')}</a> : ''}
    <a class={linkClass} href={getLocaleUrl('products', locale)}>{t('nav.products')}</a>
    <a class={linkClass} href={getLocaleUrl('pricing', locale)}>{t('nav.pricing')}</a>
    <a class={linkClass} href={getLocaleUrl('products#research-engine', locale)}>Research engine</a>
  </div>
  <div class="xs:items-start group flex flex-col items-center">
    <h3>{t('labels.company')}</h3>
    <a class={linkClass} href={getLocaleUrl('founder', locale)}>{t('nav.founder')}</a>
    <a class={linkClass} href={getLocaleUrl('contact', locale)}>{t('nav.contact')}</a>
    <a class={linkClass} href={getLocaleUrl('blog', locale)}>{t('nav.blog')}</a>
  </div>
  <div class="xs:items-start group flex flex-col items-center">
    <h3>{t('labels.resources')}</h3>
    <a class={linkClass} href={getLocaleUrl('architecture', locale)}>{t('nav.architecture')}</a>
    <a class={linkClass} href={getLocaleUrl('data-and-ip', locale)}>{t('nav.data-and-ip')}</a>
    <a class={linkClass} href={getLocaleUrl('faq', locale)}>{t('nav.faq')}</a>
    <a class={`${linkClass} external-link`} href="/intel-echo/" target="_blank" rel="noopener">Intel Echo</a>
    <a class={`${linkClass} external-link`} href="https://www.npmjs.com/package/intel-echo" target="_blank" rel="noopener">npm: intel-echo</a>
    <a class={`${linkClass} external-link`} href="https://github.com/praveenshahi" target="_blank" rel="noopener">GitHub</a>
  </div>
</nav>
