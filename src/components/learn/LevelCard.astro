---
/**
 * One level, expanding in place.
 *
 * Uses <details> rather than linking to a /learn-ai/level-N route: those pages
 * do not exist, and a card that expands beats a card that 404s.
 *
 * The glyph is the hero ladder's node shape at three densities - one dot for a
 * task, three linked dots for a workflow, a small network for a system.
 */
interface Props {
  level: string;
  name: string;
  quote: string;
  unit: string;
  builds: string;
  audience: string;
  length: string;
  glyph: "task" | "workflow" | "system";
}

const { level, name, quote, unit, builds, audience, length, glyph } = Astro.props as Props;

const glyphLabel = {
  task: "A single node, representing one task",
  workflow: "Three connected nodes, representing a workflow",
  system: "A network of nodes, representing a system",
}[glyph];
---

<details class="a-card a-card-hover level-card group flex h-full flex-col gap-0 p-0">
  <summary class="flex cursor-pointer list-none flex-col gap-4 p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-col gap-1">
        <span class="text-primary dark:text-primary-light font-mono text-xs font-bold tracking-[0.18em] uppercase">{level}</span>
        <span class="text-xl font-bold">{name}</span>
      </div>
      <svg class="level-glyph shrink-0" viewBox="0 0 44 44" role="img" aria-label={glyphLabel}>
        {glyph === "task" && <circle cx="22" cy="22" r="5" class="g-dot" />}
        {glyph === "workflow" && (
          <>
            <path d="M8 22 H36" class="g-line" />
            <circle cx="8" cy="22" r="4" class="g-dot" />
            <circle cx="22" cy="22" r="4" class="g-dot" />
            <circle cx="36" cy="22" r="4" class="g-dot" />
          </>
        )}
        {glyph === "system" && (
          <>
            <path d="M22 10 L10 30 M22 10 L34 30 M10 30 L34 30 M22 10 L22 30" class="g-line" />
            <circle cx="22" cy="10" r="3.6" class="g-dot" />
            <circle cx="10" cy="30" r="3.6" class="g-dot" />
            <circle cx="34" cy="30" r="3.6" class="g-dot" />
            <circle cx="22" cy="30" r="3.6" class="g-dot" />
          </>
        )}
      </svg>
    </div>

    <p class="m-0 text-base text-stone-700 italic dark:text-stone-200">&ldquo;{quote}&rdquo;</p>

    <div class="mt-auto flex items-center justify-between gap-3 border-t border-stone-200 pt-4 dark:border-stone-800">
      <span class="text-sm text-stone-500 dark:text-stone-400">
        Unit of work: <span class="font-semibold text-stone-700 dark:text-stone-200">{unit}</span>
      </span>
      <span class="text-primary dark:text-primary-light flex items-center gap-1 text-sm font-semibold">
        <span class="level-more">Details</span>
        <svg class="level-chevron h-4 w-4" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 8l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </div>
  </summary>

  <div class="flex flex-col gap-4 border-t border-stone-200 px-6 pt-5 pb-6 dark:border-stone-800">
    <div>
      <span class="text-xs font-bold tracking-widest text-stone-500 uppercase dark:text-stone-400">You build</span>
      <p class="m-0 mt-1.5 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{builds}</p>
    </div>
    <div>
      <span class="text-xs font-bold tracking-widest text-stone-500 uppercase dark:text-stone-400">For</span>
      <p class="m-0 mt-1.5 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{audience}</p>
    </div>
    <div>
      <span class="text-xs font-bold tracking-widest text-stone-500 uppercase dark:text-stone-400">Length</span>
      <p class="m-0 mt-1.5 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{length}</p>
    </div>
  </div>
</details>

<style>
  @reference "../../styles/tailwind.config.css";

  .level-card summary::-webkit-details-marker {
    display: none;
  }
  .level-card[open] .level-chevron {
    transform: rotate(180deg);
  }
  .level-chevron {
    transition: transform 0.25s ease;
  }
  .level-card[open] .level-more::after {
    content: '';
  }
  .level-glyph {
    @apply h-11 w-11;
  }
  .g-dot {
    fill: var(--color-primary);
  }
  :global(.dark) .g-dot {
    fill: var(--color-primary-light);
  }
  .g-line {
    fill: none;
    stroke: var(--color-stone-400);
    stroke-width: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .level-chevron {
      transition: none;
    }
  }
</style>
