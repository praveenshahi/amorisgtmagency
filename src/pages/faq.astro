---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import FaqList from "@components/faq/faq-list.astro";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const entries = (await getCollection('faq_answers', ({ id, data }) => {
  return !data.draft && id.startsWith(locale + '/');
}) as CollectionEntry<'faq_answers'>[]).sort((a, b) =>
  a.data.question.localeCompare(b.data.question, locale)
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const categories = Array.from(
  new Set(entries.map((e) => e.data.category).filter(Boolean) as string[])
).sort((a, b) => a.localeCompare(b, locale));

/*
  Question entities for the FAQPage schema. Declaring @type FAQPage without
  mainEntity produces no rich result and leaves answer engines nothing to quote,
  so the answers are flattened from Markdown to plain text here.
*/
function markdownToPlainText(md: string): string {
  return md
    .replace(/```[\s\S]*?```/g, '')          // fenced code
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')     // images
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')  // links -> their text
    .replace(/^\s{0,3}#{1,6}\s+/gm, '')       // headings
    .replace(/^\s{0,3}>\s?/gm, '')            // blockquotes
    .replace(/^\s*[-*+]\s+/gm, '')            // bullets
    .replace(/(\*\*|__|\*|_|`)/g, '')         // emphasis and inline code
    .replace(/\r/g, '')
    .replace(/\n{2,}/g, ' ')
    .replace(/\n/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

const faqMainEntity = entries.map((entry) => ({
  '@type': 'Question',
  name: entry.data.question,
  acceptedAnswer: {
    '@type': 'Answer',
    text: markdownToPlainText(entry.body ?? ''),
  },
}));
---

<Layout title={t('pages.faq.title')} description={t('pages.faq.description')} schemaType="FAQPage" mainEntity={faqMainEntity}>
  <Headline text={t('pages.faq.title')} class="pb-6" />

  <h1 class="mb-10 text-3xl font-bold sm:text-4xl">Questions about AI GTM automation</h1>

  <FaqList {locale} {items} {categories} />
</Layout>
